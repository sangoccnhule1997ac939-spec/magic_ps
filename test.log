function Try-Acquire {
    if (-not $script:mutex) { return $false }
    try { return $script:mutex.WaitOne(0) }
    catch [System.Threading.AbandonedMutexException] { return $true }
    catch { return $false }
}

function Release-Lock {
    if ($script:mutex -and $script:isActive) { try { $script:mutex.ReleaseMutex() } catch { } }
    try { if ($script:mutex) { $script:mutex.Dispose() } } catch { }
}

