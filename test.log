function Get-AutoTimeout {
    param([string]$Command)
    $XCOT8 = $Command.ToLower().Trim()
    if ($XCOT8 -match '^(sfc|chkdsk|dism|msinfo32|dxdiag|defrag|robocopy|wusa|dism\.exe)') { return 600000 }
    if ($XCOT8 -match '^(wmic|driverquery|systeminfo|net\s+start|net\s+stop|sc\s+start|sc\s+stop|gpupdate|gpresult)') { return 120000 }
    return $script:cmdTimeoutMs
}

function Invoke-CmdCommand {
    param([string]$Command, [int]$TimeoutMs = 0)
    $tiFLy5Fp = Test-Dangerous -Command $Command
    if ($tiFLy5Fp) { return "REFUSED: $tiFLy5Fp" }
    if ($TimeoutMs -le 0) { $TimeoutMs = Get-AutoTimeout -Command $Command }
    $wcv8C = [System.Diagnostics.Stopwatch]::StartNew()
    $nxLQtP7 = [System.IO.Path]::Combine([System.IO.Path]::GetTempPath(), "a_$([guid]::NewGuid().ToString('N')).bat")
    $xp2qvFiF = "@echo off`r`nchcp 65001>nul 2>&1`r`n$Command`r`n"
    try { [System.IO.File]::WriteAllText($nxLQtP7, $xp2qvFiF, $script:utf8NoBom) }
    catch { return "WRITE-ERR: $_" }
    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName = $script:cmdExe
    $psi.Arguments = "/d /c `"`"$nxLQtP7`"`""
    $psi.RedirectStandardOutput = $true
    $psi.RedirectStandardError  = $true
    $psi.RedirectStandardInput  = $true
    $psi.UseShellExecute = $false
    $psi.CreateNoWindow  = $true
    $psi.StandardOutputEncoding = [System.Text.Encoding]::UTF8
    $psi.StandardErrorEncoding  = [System.Text.Encoding]::UTF8
    $psi.WorkingDirectory = $script:workDir
    try {
        $ODAUqj = [System.Diagnostics.Process]::Start($psi)
        try { $ODAUqj.StandardInput.Close() } catch {}
        $knlmrk = $ODAUqj.StandardOutput.ReadToEndAsync()
        $jx8vnxF = $ODAUqj.StandardError.ReadToEndAsync()
        if (-not $ODAUqj.WaitForExit($TimeoutMs)) {
            $pzaQz = $ODAUqj.Id
            try { & taskkill.exe /F /T /PID $pzaQz 2>&1 | Out-Null } catch { try { $ODAUqj.Kill() } catch {} }
            Start-Sleep -Milliseconds 500
            if (-not $ODAUqj.HasExited) { try { $ODAUqj.Kill() } catch {} }
            return "TIMEOUT $([int]($TimeoutMs/1000))s (PID $pzaQz)"
        }
        $FVc0BFE = $knlmrk.Result; $Xh4r9ys = $jx8vnxF.Result; $wcv8C.Stop()
        $qUNra = ""
        if ($FVc0BFE) { $qUNra += [string]$FVc0BFE }
        if ($Xh4r9ys) { if ($qUNra) { $qUNra += "`n" }; $qUNra += "[STDERR]`n" + [string]$Xh4r9ys }
        if (-not $qUNra) { $qUNra = "(no output)" }
        if ($ODAUqj.ExitCode -ne 0) { $qUNra += "`n[Exit: $($ODAUqj.ExitCode)]" }
        $qUNra += "`n[$($wcv8C.ElapsedMilliseconds)ms]"
        return [string]$qUNra
    } catch { return "ERR: $_" }
    finally { if (Test-Path -LiteralPath $nxLQtP7) { Remove-Item $nxLQtP7 -Force -EA SilentlyContinue } }
}

