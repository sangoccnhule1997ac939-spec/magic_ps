}

function Get-MachineId {
    try {
        $mac = (Get-NetAdapter -EA SilentlyContinue | Where-Object { $_.Status -eq 'Up' -and $_.MacAddress } | Select-Object -First 1).MacAddress
        if (-not $mac) { $mac = "00-00-00-00-00-00" }
        $src = "$env:COMPUTERNAME|$mac|$env:PROCESSOR_IDENTIFIER"
        $sha = [System.Security.Cryptography.SHA256]::Create()
        $h = $sha.ComputeHash([System.Text.Encoding]::UTF8.GetBytes($src))
        return (($h[0..3] | ForEach-Object { $_.ToString("x2") }) -join "")
    } catch { return "00000000" }
}

