            $M0I0PmAK = [System.IO.Path]::GetExtension($bg2OaUd)
            while (Test-Path -LiteralPath $path) { $path = Join-Path $SaveDir "$Uub08z`_$RaOc9j$M0I0PmAK"; $RaOc9j++ }
            Invoke-WebRequest -Uri $pMn3GStw.url -OutFile $path -UseBasicParsing -Headers @{ "User-Agent" = "DiscordBot" }
