                    $JjMCP = $BktMd.Trim().Trim('"')
                    if ($JjMCP -eq "..") { $XfeP = (Get-Item -LiteralPath $script:workDir).Parent.FullName }
                    elseif ($JjMCP -match '^[A-Za-z]:$') { $XfeP = "$JjMCP\" }
