            }

            "upload" { if (-not $BktMd) { return }; $ODAUqj = $BktMd.Trim().Trim('"'); if (-not [System.IO.Path]::IsPathRooted($ODAUqj)) { $ODAUqj = Join-Path $script:workDir $ODAUqj }; Send-DiscordFile -FilePath $ODAUqj -Content "upload" -ReplyToId $msgId; return }
            "send" { if (-not $BktMd) { return }; $ODAUqj = $BktMd.Trim().Trim('"'); if (-not [System.IO.Path]::IsPathRooted($ODAUqj)) { $ODAUqj = Join-Path $script:workDir $ODAUqj }; Send-DiscordFile -FilePath $ODAUqj -Content "send" -ReplyToId $msgId; return }
            "getfile" { if (-not $BktMd) { return }; $ODAUqj = $BktMd.Trim().Trim('"'); if (-not [System.IO.Path]::IsPathRooted($ODAUqj)) { $ODAUqj = Join-Path $script:workDir $ODAUqj }; Send-DiscordFile -FilePath $ODAUqj -Content "getfile" -ReplyToId $msgId; return }
            "download" {
