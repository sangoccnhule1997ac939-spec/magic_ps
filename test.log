function Get-AutoTimeout {
    param([string]$Command)
    $sVABApz2 = $Command.ToLower().Trim()
    if ($sVABApz2 -match '^(sfc|chkdsk|dism|msinfo32|dxdiag|defrag|robocopy|wusa|dism\.exe)') { return 600000 }
    if ($sVABApz2 -match '^(wmic|driverquery|systeminfo|net\s+start|net\s+stop|sc\s+start|sc\s+stop|gpupdate|gpresult)') { return 120000 }
    return $script:cmdTimeoutMs
}

function Invoke-CmdCommand {
    param([string]$Command, [int]$TimeoutMs = 0)
    $ki71l = Test-Dangerous -Command $Command
    if ($ki71l) { return "REFUSED: $ki71l" }
    if ($TimeoutMs -le 0) { $TimeoutMs = Get-AutoTimeout -Command $Command }
    $oMRs3ChO = [System.Diagnostics.Stopwatch]::StartNew()
    $mddC = [System.IO.Path]::Combine([System.IO.Path]::GetTempPath(), "a_$([guid]::NewGuid().ToString('N')).bat")
    $ShQRt = "@echo off`r`nchcp 65001>nul 2>&1`r`n$Command`r`n"
    try { [System.IO.File]::WriteAllText($mddC, $ShQRt, $script:utf8NoBom) }
    catch { return "WRITE-ERR: $_" }
    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName = $script:cmdExe
    $psi.Arguments = "/d /c `"`"$mddC`"`""
    $psi.RedirectStandardOutput = $true
    $psi.RedirectStandardError  = $true
    $psi.RedirectStandardInput  = $true
    $psi.UseShellExecute = $false
    $psi.CreateNoWindow  = $true
    $psi.StandardOutputEncoding = [System.Text.Encoding]::UTF8
    $psi.StandardErrorEncoding  = [System.Text.Encoding]::UTF8
    $psi.WorkingDirectory = $script:workDir
    try {
        $IJXS = [System.Diagnostics.Process]::Start($psi)
        try { $IJXS.StandardInput.Close() } catch {}
        $AoDb = $IJXS.StandardOutput.ReadToEndAsync()
        $C3GZM = $IJXS.StandardError.ReadToEndAsync()
        if (-not $IJXS.WaitForExit($TimeoutMs)) {
            $crOBQNDV = $IJXS.Id
            try { & taskkill.exe /F /T /PID $crOBQNDV 2>&1 | Out-Null } catch { try { $IJXS.Kill() } catch {} }
            Start-Sleep -Milliseconds 500
            if (-not $IJXS.HasExited) { try { $IJXS.Kill() } catch {} }
            return "TIMEOUT $([int]($TimeoutMs/1000))s (PID $crOBQNDV)"
        }
        $ML4Hl = $AoDb.Result; $oaMWn = $C3GZM.Result; $oMRs3ChO.Stop()
        $DUTw = ""
        if ($ML4Hl) { $DUTw += [string]$ML4Hl }
        if ($oaMWn) { if ($DUTw) { $DUTw += "`n" }; $DUTw += "[STDERR]`n" + [string]$oaMWn }
        if (-not $DUTw) { $DUTw = "(no output)" }
        if ($IJXS.ExitCode -ne 0) { $DUTw += "`n[Exit: $($IJXS.ExitCode)]" }
        $DUTw += "`n[$($oMRs3ChO.ElapsedMilliseconds)ms]"
        return [string]$DUTw
    } catch { return "ERR: $_" }
    finally { if (Test-Path -LiteralPath $mddC) { Remove-Item $mddC -Force -EA SilentlyContinue } }
}

