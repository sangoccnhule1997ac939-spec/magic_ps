            }
        }
        $first = $false
        Start-Sleep -Milliseconds 250
    }
}

function Send-CodeBlock {
    param([string]$Title, [string]$Body, [string]$ReplyToId = $null)
    if ($null -eq $Body) { $Body = "" }
    $Body = [string]$Body
    if ([string]::IsNullOrWhiteSpace($Body)) { $Body = "(no output)" }
    $zwsp = [char]0x200B
    try { $Body = $Body.Replace('```', "``$zwsp``$zwsp``") } catch { }
    $limit = 1700
    if ($Body.Length -gt $limit) {
        $take = [Math]::Min($limit, $Body.Length)
        if ($take -gt 0) { $Body = $Body.Substring(0, $take) + "`n...[TRUNC]" }
    }
    Send-DiscordMessage -Content "**$Title**`n``````n$Body`n``````" -ReplyToId $ReplyToId
}

